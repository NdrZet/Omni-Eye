    <sys:String x:Key="Firewall_Title">Сетевой экран</sys:String>
    <sys:String x:Key="Firewall_Subtitle">Параметры и правила блокировки Windows Defender Firewall</sys:String>
    <sys:String x:Key="Firewall_Header">Параметры Сетевого Фильтра Windows Defender Firewall</sys:String>
    <sys:String x:Key="Firewall_HeaderDesc">OmniEye использует прямое COM-взаимодействие с интерфейсом INetFwPolicy2 Windows.</sys:String>
    <sys:String x:Key="Firewall_PolicyTitle">Политика по умолчанию</sys:String>
    <sys:String x:Key="Firewall_PolicyDescBlock">DefaultOutboundAction: BLOCK (все исходящие соединения заблокированы на уровне ядра NDIS, кроме Белого списка).</sys:String>
    <sys:String x:Key="Firewall_PolicyDescAllow">DefaultOutboundAction: ALLOW (исходящие соединения разрешены по умолчанию для всех приложений).</sys:String>
    <sys:String x:Key="Firewall_BtnAllowAll">Разрешить все</sys:String>
    <sys:String x:Key="Firewall_BtnBlockAll">Блокировать все</sys:String>
    <sys:String x:Key="Firewall_ExceptionsTitle">Системные исключения</sys:String>
    <sys:String x:Key="Firewall_ExceptionsDesc">DNS (UDP/TCP 53), DHCP (UDP 67/68), Windows Update Services.</sys:String>
