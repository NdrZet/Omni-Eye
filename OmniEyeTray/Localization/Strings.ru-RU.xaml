    <!-- Kernel Guard (ViewInjection) -->
    <sys:String x:Key="Injection_Title">Защита ядра</sys:String>
    <sys:String x:Key="Injection_Subtitle">Мониторинг инъекций через ETW и заморозка NtSuspendProcess</sys:String>
    <sys:String x:Key="Injection_Header">Мониторинг внедрения кода и целостности процессов</sys:String>
    <sys:String x:Key="Injection_HeaderDesc">Использует Kernel ETW (Event Tracing for Windows) Microsoft-Windows-Kernel-Process.</sys:String>
    <sys:String x:Key="Injection_FreezeTitle">Механизм заморозки процессов</sys:String>
    <sys:String x:Key="Injection_FreezeDesc">При обнаружении подозрительного запуска атакующий процесс немедленно останавливается через NtSuspendProcess.</sys:String>
    <sys:String x:Key="Injection_TimerTitle">Таймер безопасности</sys:String>
    <sys:String x:Key="Injection_TimerDesc">Если пользователь не принял решение в окне тревоги за 60 секунд, процесс автоматически уничтожается.</sys:String>

    <!-- Settings (ViewSettings) -->
    <sys:String x:Key="Settings_Title">Параметры</sys:String>
    <sys:String x:Key="Settings_Subtitle">Режимы работы, шифрование базы данных и IPC</sys:String>
