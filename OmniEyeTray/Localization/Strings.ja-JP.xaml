    <sys:String x:Key="Firewall_PolicyDescAllow">DefaultOutboundAction: ALLOW (すべてのアプリケーションの送信接続がデフォルトで許可されます)。</sys:String>
    <sys:String x:Key="Firewall_BtnAllowAll">すべて許可</sys:String>
    <sys:String x:Key="Firewall_BtnBlockAll">すべて遮断</sys:String>
