    <!-- Firewall (ViewFirewall) -->
    <sys:String x:Key="Firewall_Title">Firewall</sys:String>
    <sys:String x:Key="Firewall_Subtitle">Windows Defender Firewall blocking parameters and rules</sys:String>
    <sys:String x:Key="Firewall_Header">Windows Defender Firewall Network Filter Options</sys:String>
    <sys:String x:Key="Firewall_HeaderDesc">OmniEye uses direct COM interaction with the Windows INetFwPolicy2 interface.</sys:String>
    <sys:String x:Key="Firewall_PolicyTitle">Default Outbound Policy</sys:String>
    <sys:String x:Key="Firewall_PolicyDescBlock">DefaultOutboundAction: BLOCK (all outbound connections are blocked at the NDIS kernel level, except Whitelist).</sys:String>
    <sys:String x:Key="Firewall_PolicyDescAllow">DefaultOutboundAction: ALLOW (outbound connections are allowed by default for all applications).</sys:String>
    <sys:String x:Key="Firewall_BtnAllowAll">Allow All</sys:String>
    <sys:String x:Key="Firewall_BtnBlockAll">Block All</sys:String>
    <sys:String x:Key="Firewall_ExceptionsTitle">System Exceptions</sys:String>
    <sys:String x:Key="Firewall_ExceptionsDesc">DNS (UDP/TCP 53), DHCP (UDP 67/68), Windows Update Services.</sys:String>
    <sys:String x:Key="Firewall_WatchdogTitle">Self-Healing Watchdog</sys:String>
    <sys:String x:Key="Firewall_WatchdogDesc">Polling interval: every 3000 ms. If firewall rules are removed by third-party software, they are immediately recreated.</sys:String>

    <!-- Kernel Guard (ViewInjection) -->
    <sys:String x:Key="Injection_Title">Kernel Guard</sys:String>
    <sys:String x:Key="Injection_Subtitle">ETW kernel injection monitoring and NtSuspendProcess freeze</sys:String>
    <sys:String x:Key="Injection_Header">Code Injection Monitoring and Process Integrity</sys:String>
    <sys:String x:Key="Injection_HeaderDesc">Utilizes Kernel ETW (Event Tracing for Windows) Microsoft-Windows-Kernel-Process.</sys:String>
    <sys:String x:Key="Injection_FreezeTitle">Process Freeze Mechanism</sys:String>
    <sys:String x:Key="Injection_FreezeDesc">Upon detecting suspicious execution, the attacking process is instantly suspended via NtSuspendProcess.</sys:String>
    <sys:String x:Key="Injection_TimerTitle">Safety Timer</sys:String>
    <sys:String x:Key="Injection_TimerDesc">If the user does not make a decision in the alert dialog within 60 seconds, the process is automatically terminated.</sys:String>

    <!-- Settings (ViewSettings) -->
    <sys:String x:Key="Settings_Title">Settings</sys:String>
    <sys:String x:Key="Settings_Subtitle">Operating modes, database encryption, and IPC</sys:String>
    <sys:String x:Key="Settings_Header">OmniEye Parameters and Operating Modes</sys:String>
    <sys:String x:Key="Settings_LanguageTitle">Display Language</sys:String>
    <sys:String x:Key="Settings_LanguageDesc">Select the display language for the application interface and notifications.</sys:String>
    <sys:String x:Key="Settings_DevModeTitle">Developer Mode</sys:String>
    <sys:String x:Key="Settings_DevModeDesc">Allows rolling back firewall rules on exit and adding unsigned files with user confirmation.</sys:String>
    <sys:String x:Key="Settings_DbTitle">Protected Database</sys:String>
    <sys:String x:Key="Settings_DbPath">Path: C:\ProgramData\OmniEye\config.db</sys:String>
    <sys:String x:Key="Settings_DbCrypto">Algorithm: AES-256 (SQLCipher) + Windows DPAPI (LocalMachine) hardware key.</sys:String>

