    <sys:String x:Key="Tray_AlertMsg">Process PID {0} is attempting to inject code into {1}</sys:String>

    <!-- Messages & Dialogs -->
    <sys:String x:Key="Msg_ConfirmPolicyAllow">Switch default firewall policy to «ALLOW ALL (Permissive)»?&#x0a;&#x0a;Outbound traffic for all programs will be allowed by default at the Windows Defender Firewall kernel level.</sys:String>
    <sys:String x:Key="Msg_PolicyAllowSwitched">Firewall policy switched: ALLOW ALL (Permissive).&#x0a;Outbound connections are allowed by default.</sys:String>
    <sys:String x:Key="Msg_PolicyBlockSwitched">Firewall policy switched: BLOCK ALL (Zero-Trust).&#x0a;All outbound connections are blocked, except Whitelist.</sys:String>
    <sys:String x:Key="Msg_PolicyChangeTitle">Policy Changed</sys:String>
    <sys:String x:Key="Msg_DeleteGroupConfirm">Remove entire group «{0}» ({1} files) from Whitelist?&#x0a;Outbound network connections for them will be blocked.</sys:String>
    <sys:String x:Key="Msg_DeleteGroupTitle">Delete Application Group</sys:String>
    <sys:String x:Key="Msg_DeleteEntryConfirm">Remove {0} from Whitelist?&#x0a;Outbound network connections for it will be blocked.</sys:String>
    <sys:String x:Key="Msg_DeleteEntryTitle">Confirm Removal</sys:String>
    <sys:String x:Key="Msg_UnsignedStrictError">File does not have a valid Authenticode digital signature ({0}).&#x0a;&#x0a;In Strict Zero-Trust mode, adding unsigned files is prohibited!</sys:String>
    <sys:String x:Key="Msg_UnsignedDevWarning">File does not have a trusted Authenticode signature ({0}).&#x0a;&#x0a;Developer Mode is active. Are you sure you want to add this file to the Whitelist?</sys:String>
