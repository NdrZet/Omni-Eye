<Window x:Class="OmniEyeTray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:OmniEye.Core.Models;assembly=OmniEye.Core"
        Title="OmniEye — Консоль Безопасности" 
        Height="680" Width="1040"
        MinHeight="560" MinWidth="840"
        WindowStartupLocation="CenterScreen"
        Background="#202020"
        Foreground="#FFFFFF"
        FontFamily="Segoe UI Variable, Segoe UI, -apple-system, sans-serif">

    <Window.Resources>
        <!-- Windows 11 Button Base -->
        <Style x:Key="FluentButton" TargetType="Button">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#383838"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#383838"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#484848"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#242424"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 Accent Primary Button -->
        <Style x:Key="FluentPrimaryButton" TargetType="Button" BasedOn="{StaticResource FluentButton}">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="BorderBrush" Value="#1B87DE"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#1886D9"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#2A92E4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 Danger Button -->
        <Style x:Key="FluentDangerButton" TargetType="Button" BasedOn="{StaticResource FluentButton}">
            <Setter Property="Background" Value="#2D1C20"/>
            <Setter Property="BorderBrush" Value="#5E262E"/>
            <Setter Property="Foreground" Value="#FF99A4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#3D2026"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#752D37"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#221518"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 Navigation Item Style -->
        <Style x:Key="Win11NavItem" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Selected Blue Pill Indicator -->
                                <Border x:Name="Indicator" Width="3" Height="16" Background="#4CC2FF" CornerRadius="1.5" 
                                        HorizontalAlignment="Left" Visibility="Collapsed" Margin="-6,0,8,0"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#2B2B2B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#2B2B2B"/>
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Navigation Sidebar (Windows 11 Settings Style) -->
            <ColumnDefinition Width="230" />
            <!-- Main Content Area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->
        <Border Grid.Column="0" Background="#1B1B1B" BorderBrush="#2E2E2E" BorderThickness="0,0,1,0" Padding="14,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- App Identity (Win11 User Profile style) -->
                <StackPanel Grid.Row="0" Margin="4,0,4,20">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#0078D4" CornerRadius="8" Width="38" Height="38" Margin="0,0,10,0">
                            <TextBlock Text="🛡️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="OmniEye" FontWeight="Bold" FontSize="16" Foreground="#FFFFFF" />
                            <TextBlock Text="Zero-Trust System" FontSize="11" Foreground="#A0A0A0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Menu (Windows 11 Settings Sidebar) -->
                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="NavDashboard" Content="🏠  Главная" Style="{StaticResource Win11NavItem}" IsChecked="True" Click="NavDashboard_Click"/>
                    <RadioButton x:Name="NavFirewall" Content="🧱  Сетевой экран" Style="{StaticResource Win11NavItem}" Click="NavFirewall_Click"/>
                    <RadioButton x:Name="NavInjection" Content="⚡  Защита ядра" Style="{StaticResource Win11NavItem}" Click="NavInjection_Click"/>
                    <RadioButton x:Name="NavSettings" Content="⚙️  Параметры" Style="{StaticResource Win11NavItem}" Click="NavSettings_Click"/>
                </StackPanel>

                <!-- Sidebar Footer -->
                <StackPanel Grid.Row="2" Margin="4,0,4,0">
                    <Border Background="#242424" CornerRadius="6" Padding="10,8" BorderBrush="#333333" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Хранилище AES-256" FontSize="10" FontWeight="SemiBold" Foreground="#6CCB5F"/>
                            <TextBlock Text="DPAPI LocalMachine" FontSize="10" Foreground="#808080" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= MAIN CONTENT ================= -->
        <Grid Grid.Column="1" Margin="24,20,24,16">
            <Grid.RowDefinitions>
                <!-- Top Breadcrumb & Status Badges -->
                <RowDefinition Height="Auto" />
                <!-- Dynamic Content (Pages) -->
                <RowDefinition Height="*" />
                <!-- Bottom Bar -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Header (Windows 11 Style) -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtPageTitle" Text="Главная" FontWeight="SemiBold" FontSize="24" Foreground="#FFFFFF"/>
                    <TextBlock x:Name="TxtPageSubtitle" Text="Мониторинг исходящего сетевого трафика и изоляция процессов" 
                               FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Status Badges (Windows 11 Pills) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="BadgeDevMode" Background="#332508" BorderBrush="#6E4D0C" BorderThickness="1" CornerRadius="12" Padding="10,3" Margin="0,0,8,0">
                        <TextBlock x:Name="TxtDevMode" Text="DEVELOPER MODE" FontWeight="SemiBold" FontSize="11" Foreground="#FFC83B"/>
                    </Border>
                    <Border x:Name="BadgeStatus" Background="#133821" BorderBrush="#1E6135" BorderThickness="1" CornerRadius="12" Padding="10,3">
                        <TextBlock x:Name="TxtServiceStatus" Text="СЛУЖБА ПОДКЛЮЧЕНА" FontWeight="SemiBold" FontSize="11" Foreground="#6CCB5F"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ================= VIEW 1: DASHBOARD (HOME) ================= -->
            <Grid x:Name="ViewDashboard" Grid.Row="1">
                <Grid.RowDefinitions>
                    <!-- Top Metric Cards -->
                    <RowDefinition Height="Auto" />
                    <!-- Action & Filter Bar -->
                    <RowDefinition Height="Auto" />
                    <!-- Responsive List of Windows 11 Cards -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 3 Top Metric Hero Cards (Windows 11 Elevated Surface) -->
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: Outbound Firewall -->
                    <Border Grid.Column="0" Background="#2B2B2B" CornerRadius="8" Padding="14" BorderBrush="#383838" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="СЕТЕВОЙ ФИЛЬТР (FIREWALL)" FontSize="10" FontWeight="SemiBold" Foreground="#A0A0A0" />
                            <TextBlock x:Name="TxtCardOutbound" Text="БЛОКИРОВАН (BLOCK)" FontSize="15" FontWeight="Bold" Foreground="#FF99A4" Margin="0,4,0,2" />
                            <TextBlock Text="DNS (53), DHCP (67/68), WinUpdate разрешены" FontSize="11" Foreground="#808080" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Whitelist -->
                    <Border Grid.Column="2" Background="#2B2B2B" CornerRadius="8" Padding="14" BorderBrush="#383838" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="БЕЛЫЙ СПИСОК (WHITELIST)" FontSize="10" FontWeight="SemiBold" Foreground="#A0A0A0" />
                            <TextBlock x:Name="TxtCardWhitelistCount" Text="0 приложений" FontSize="15" FontWeight="Bold" Foreground="#4CC2FF" Margin="0,4,0,2" />
                            <TextBlock Text="Сквозная проверка WinVerifyTrust Authenticode" FontSize="11" Foreground="#808080" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Memory Protection -->
                    <Border Grid.Column="4" Background="#2B2B2B" CornerRadius="8" Padding="14" BorderBrush="#383838" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="ЗАЩИТА ПАМЯТИ (ANTI-INJECTION)" FontSize="10" FontWeight="SemiBold" Foreground="#A0A0A0" />
                            <TextBlock x:Name="TxtCardInjection" Text="АКТИВЕН (ETW + NtSuspend)" FontSize="15" FontWeight="Bold" Foreground="#6CCB5F" Margin="0,4,0,2" />
                            <TextBlock x:Name="TxtCardAttempts" Text="0 подозрительных попыток заблокировано" FontSize="11" Foreground="#808080" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Command & Search Bar -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Разрешенные программы" 
                               FontWeight="SemiBold" FontSize="15" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,14,0" />

                    <!-- Windows 11 Search Box with real-time filtering -->
                    <Border Grid.Column="1" Background="#262626" BorderBrush="#383838" BorderThickness="1" CornerRadius="4" 
                            Height="32" Margin="0,0,14,0" HorizontalAlignment="Stretch" MaxWidth="380">
                        <Grid Margin="10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" FontSize="11" Foreground="#707070" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="TxtSearch" Grid.Column="1" Background="Transparent" Foreground="#FFFFFF" 
                                     BorderThickness="0" CaretBrush="#4CC2FF" FontSize="12" VerticalAlignment="Center"
                                     TextChanged="TxtSearch_TextChanged"/>
                            <TextBlock Grid.Column="1" Text="Поиск программы или пути..." FontSize="12" Foreground="#707070" 
                                       IsHitTestVisible="False" VerticalAlignment="Center"
                                       Visibility="{Binding Text.IsEmpty, ElementName=TxtSearch, Converter={x:Null}}"/>
                        </Grid>
                    </Border>

                    <!-- Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="BtnAdd" Content="+ Добавить программу" 
                                Style="{StaticResource FluentPrimaryButton}" Margin="0,0,8,0" Click="BtnAdd_Click"/>
                        <Button x:Name="BtnRefresh" Content="Обновить" 
                                Style="{StaticResource FluentButton}" Click="BtnRefresh_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Application Suites (Windows 11 Responsive Cards) -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ListAppGroups">
                        <!-- Group Style: Each Suite is an Expandable Windows 11 Card -->
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="{x:Type GroupItem}">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                                    <Border Background="#2B2B2B" BorderBrush="#383838" BorderThickness="1" 
                                                            CornerRadius="8" Margin="0,0,0,10">
                                                        <Expander IsExpanded="True" Foreground="#FFFFFF" Background="Transparent" BorderThickness="0">
                                                            <!-- Custom Windows 11 Expander Header (Clean, No Aero Circle!) -->
                                                            <Expander.Header>
                                                                <Grid Margin="10,8" HorizontalAlignment="Stretch">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <TextBlock Text="📁" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" 
                                                                               Foreground="#4CC2FF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                                                    <!-- Item count pill -->
                                                                    <Border Grid.Column="2" Background="#1E1E1E" BorderBrush="#383838" BorderThickness="1" 
                                                                            CornerRadius="10" Padding="8,2" Margin="8,0">
                                                                        <TextBlock Text="{Binding ItemCount, StringFormat='{}{0} файлов'}" 
                                                                                   FontSize="11" FontWeight="SemiBold" Foreground="#6CCB5F"/>
                                                                    </Border>

                                                                    <!-- Delete whole group button -->
                                                                    <Button Grid.Column="3" Content="Удалить группу" Click="BtnDeleteGroup_Click" 
                                                                            Margin="4,0,10,0" Padding="8,2" FontSize="11" FontWeight="SemiBold"
                                                                            Background="#2D1C20" Foreground="#FF99A4" BorderBrush="#5E262E" BorderThickness="1"
                                                                            Cursor="Hand">
                                                                        <Button.Resources>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="CornerRadius" Value="4"/>
                                                                            </Style>
                                                                        </Button.Resources>
                                                                    </Button>
                                                                </Grid>
                                                            </Expander.Header>

                                                            <!-- Child Executables List inside Card -->
                                                            <Border BorderBrush="#383838" BorderThickness="0,1,0,0">
                                                                <ItemsPresenter />
                                                            </Border>
                                                        </Expander>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>

                        <!-- Item Template: Child Executable Row (Responsive Grid) -->
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:WhitelistEntry}">
                                <Border BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="14,8" Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <!-- File Name & Path -->
                                            <ColumnDefinition Width="*" MinWidth="200"/>
                                            <!-- Certificate Subject -->
                                            <ColumnDefinition Width="220" />
                                            <!-- Authenticode Badge -->
                                            <ColumnDefinition Width="130" />
                                            <!-- Date -->
                                            <ColumnDefinition Width="110" />
                                            <!-- Actions -->
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Name & Path -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding FilePath}" FontSize="11" Foreground="#808080" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Certificate Subject -->
                                        <TextBlock Grid.Column="1" Text="{Binding SignerSubject}" FontSize="11" Foreground="#A0A0A0" 
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>

                                        <!-- Authenticode Badge -->
                                        <Border Grid.Column="2" Background="#133821" BorderBrush="#1E6135" BorderThickness="1" 
                                                CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="✓ ПОДПИСАН" FontSize="10" FontWeight="SemiBold" Foreground="#6CCB5F"/>
                                        </Border>

                                        <!-- Date -->
                                        <TextBlock Grid.Column="3" Text="{Binding CreatedAt, StringFormat=\{0:dd.MM.yyyy HH:mm\}}" 
                                                   FontSize="11" Foreground="#707070" VerticalAlignment="Center"/>

                                        <!-- Delete single button -->
                                        <Button Grid.Column="4" Content="✕" Click="BtnDeleteEntry_Click" ToolTip="Удалить только этот файл"
                                                Width="26" Height="26" Background="#242424" BorderBrush="#383838" BorderThickness="1" 
                                                Foreground="#FF99A4" FontSize="11" FontWeight="Bold" Cursor="Hand" HorizontalAlignment="Right">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="4"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ================= VIEW 2: FIREWALL ================= -->
            <Grid x:Name="ViewFirewall" Grid.Row="1" Visibility="Collapsed">
                <Border Background="#2B2B2B" CornerRadius="8" Padding="20" BorderBrush="#383838" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Параметры Сетевого Фильтра Windows Defender Firewall" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <TextBlock Text="OmniEye использует прямое COM-взаимодействие с интерфейсом INetFwPolicy2 Windows." FontSize="12" Foreground="#A0A0A0" Margin="0,0,0,16"/>

                        <Border Background="#242424" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Политика по умолчанию" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF"/>
                                <TextBlock Text="DefaultOutboundAction: BLOCK (все исходящие соединения заблокированы на уровне ядра NDIS)." FontSize="11" Foreground="#A0A0A0" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#242424" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Системные исключения" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF"/>
                                <TextBlock Text="DNS (UDP/TCP 53), DHCP (UDP 67/68), Windows Update Services." FontSize="11" Foreground="#A0A0A0" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#242424" CornerRadius="6" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Сторожевой таймер (Self-Healing Watchdog)" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF"/>
                                <TextBlock Text="Период опроса: каждые 3000 мс. При удалении правил брандмауэра сторонним ПО правила немедленно пересоздаются." FontSize="11" Foreground="#A0A0A0" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= VIEW 3: INJECTION ================= -->
            <Grid x:Name="ViewInjection" Grid.Row="1" Visibility="Collapsed">
                <Border Background="#2B2B2B" CornerRadius="8" Padding="20" BorderBrush="#383838" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Мониторинг внедрения кода и целостности процессов" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <TextBlock Text="Использует Kernel ETW (Event Tracing for Windows) Microsoft-Windows-Kernel-Process." FontSize="12" Foreground="#A0A0A0" Margin="0,0,0,16"/>

                        <Border Background="#242424" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Механизм заморозки процессов" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF"/>
                                <TextBlock Text="При обнаружении подозрительного запуска атакующий процесс немедленно останавливается через NtSuspendProcess." FontSize="11" Foreground="#A0A0A0" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#242424" CornerRadius="6" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Таймер безопасности" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF"/>
                                <TextBlock Text="Если пользователь не принял решение в окне тревоги за 60 секунд, процесс автоматически уничтожается." FontSize="11" Foreground="#A0A0A0" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= VIEW 4: SETTINGS ================= -->
            <Grid x:Name="ViewSettings" Grid.Row="1" Visibility="Collapsed">
                <Border Background="#2B2B2B" CornerRadius="8" Padding="20" BorderBrush="#383838" BorderThickness="1">
                    <StackPanel>
