<ui:FluentWindow x:Class="OmniEyeTray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:models="clr-namespace:OmniEye.Core.Models;assembly=OmniEye.Core"
        Title="OmniEye — Консоль Безопасности" 
        Height="720" Width="1100"
        MinHeight="580" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">

    <ui:FluentWindow.Resources>
        <!-- Windows 11 Navigation Item Style -->
        <Style x:Key="Win11NavItem" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Left Blue Selection Indicator Pill (Win11 Signature) -->
                                <Border x:Name="Indicator" Width="3" Height="18" Background="#4CC2FF" CornerRadius="1.5" 
                                        HorizontalAlignment="Left" Visibility="Collapsed" Margin="-6,0,8,0"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#12FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#1AFFFFFF"/>
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 SettingsExpander Header Template -->
        <ControlTemplate x:Key="Win11SettingsExpanderHeaderTemplate" TargetType="ToggleButton">
            <Border x:Name="HBorder" Background="#242424" Padding="16,12" CornerRadius="8,8,0,0" BorderBrush="#2D2D2D" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Icon Container -->
                    <Border Grid.Column="0" Background="#18FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" 
                            CornerRadius="6" Width="36" Height="36" Margin="0,0,12,0">
                        <ui:SymbolIcon Symbol="Folder24" FontSize="18" Foreground="#4CC2FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Suite Name and Details -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Набор исполняемых файлов и фоновых служб" FontSize="11" Foreground="#888888" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Count pill -->
                    <Border Grid.Column="2" Background="#142B1D" BorderBrush="#1E6135" BorderThickness="1" 
                            CornerRadius="10" Padding="8,2" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding ItemCount, StringFormat='{}{0} файлов'}" 
                                   FontSize="11" FontWeight="SemiBold" Foreground="#6CCB5F"/>
                    </Border>

                    <!-- Delete whole group button -->
                    <ui:Button Grid.Column="3" Content="Удалить группу" Click="BtnDeleteGroup_Click" 
                               Appearance="Danger" Margin="0,0,12,0" Padding="10,4" FontSize="11" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <!-- Clean Windows 11 Chevron -->
                    <ui:SymbolIcon Grid.Column="4" x:Name="Chevron" Symbol="ChevronDown24" FontSize="14" Foreground="#A0A0A0"
                                   VerticalAlignment="Center" Margin="4,0,8,0" RenderTransformOrigin="0.5,0.5">
                        <ui:SymbolIcon.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </ui:SymbolIcon.RenderTransform>
                    </ui:SymbolIcon>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="HBorder" Property="Background" Value="#2A2A2A"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Chevron" Property="RenderTransform">
                        <Setter.Value>
                            <RotateTransform Angle="180"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Windows 11 SettingsExpander Template -->
        <ControlTemplate x:Key="Win11SettingsExpanderTemplate" TargetType="Expander">
            <Border Background="#202020" BorderBrush="#30FFFFFF" BorderThickness="1" 
                    CornerRadius="8" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Custom Header Toggle Button -->
                    <ToggleButton x:Name="ExpanderHeaderBtn"
                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                  Template="{StaticResource Win11SettingsExpanderHeaderTemplate}"
                                  Cursor="Hand"/>

                    <!-- Child Items Container -->
                    <Border Grid.Row="1" x:Name="ExpandContentBorder" Visibility="Collapsed" 
                            Background="#181818" CornerRadius="0,0,8,8">
                        <ContentPresenter/>
                    </Border>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsExpanded" Value="True">
                    <Setter TargetName="ExpandContentBorder" Property="Visibility" Value="Visible"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="Win11SettingsExpanderStyle" TargetType="Expander">
            <Setter Property="Template" Value="{StaticResource Win11SettingsExpanderTemplate}"/>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Windows 11 Fluent Native TitleBar -->
        <ui:TitleBar Grid.Row="0" x:Name="AppTitleBar" 
                     Title="OmniEye — Консоль Zero-Trust Защиты" 
                     ShowMaximize="True" ShowMinimize="True" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left Sidebar (Windows 11 Settings Navigation) -->
                <ColumnDefinition Width="260" />
                <!-- Main Content Area -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================= SIDEBAR ================= -->
            <Border Grid.Column="0" Background="#141414" BorderBrush="#20FFFFFF" BorderThickness="0,0,1,0" Padding="14,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- App Identity (Win11 Settings Profile Style) -->
                <StackPanel Grid.Row="0" Margin="4,0,4,22">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#0078D4" CornerRadius="8" Width="40" Height="40" Margin="0,0,12,0"
                                BorderBrush="#30FFFFFF" BorderThickness="1">
                            <ui:SymbolIcon Symbol="Shield24" FontSize="20" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="OmniEye" FontWeight="SemiBold" FontSize="16" Foreground="#FFFFFF" />
                            <TextBlock Text="Zero-Trust System" FontSize="11" Foreground="#8E8E8E" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Menu (Windows 11 Settings Sidebar Items) -->
                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="NavDashboard" Style="{StaticResource Win11NavItem}" IsChecked="True" Click="NavDashboard_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Home24" FontSize="16" Margin="0,0,12,0" Foreground="#4CC2FF" />
                            <TextBlock Text="Главная" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavFirewall" Style="{StaticResource Win11NavItem}" Click="NavFirewall_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ShieldGlobe24" FontSize="16" Margin="0,0,12,0" Foreground="#A0A0A0" />
                            <TextBlock Text="Сетевой экран" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavInjection" Style="{StaticResource Win11NavItem}" Click="NavInjection_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="DeveloperBoard24" FontSize="16" Margin="0,0,12,0" Foreground="#A0A0A0" />
                            <TextBlock Text="Защита ядра" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource Win11NavItem}" Click="NavSettings_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Settings24" FontSize="16" Margin="0,0,12,0" Foreground="#A0A0A0" />
                            <TextBlock Text="Параметры" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Sidebar Footer -->
                <StackPanel Grid.Row="2" Margin="2,0,2,0">
                    <Border Background="#1CFFFFFF" CornerRadius="8" Padding="12,10" BorderBrush="#20FFFFFF" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Key20" FontSize="16" Foreground="#6CCB5F" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Хранилище AES-256" FontSize="11" FontWeight="SemiBold" Foreground="#6CCB5F"/>
                                <TextBlock Text="SQLCipher • DPAPI Machine" FontSize="10" Foreground="#888888" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= MAIN CONTENT ================= -->
        <Grid Grid.Column="1" Margin="26,18,26,16">
            <Grid.RowDefinitions>
                <!-- Top Breadcrumb & Status Badges -->
                <RowDefinition Height="Auto" />
                <!-- Dynamic Content (Pages) -->
                <RowDefinition Height="*" />
                <!-- Bottom Bar -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Header (Windows 11 Settings Style) -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtPageTitle" Text="Главная" FontWeight="SemiBold" FontSize="26" Foreground="#FFFFFF"/>
                    <TextBlock x:Name="TxtPageSubtitle" Text="Мониторинг исходящего сетевого трафика и изоляция процессов" 
                               FontSize="12" Foreground="#9E9E9E" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Status Badges (Windows 11 Pills) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="BadgeDevMode" Background="#26FFC83B" BorderBrush="#60FFC83B" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,8,0">
                        <TextBlock x:Name="TxtDevMode" Text="DEVELOPER MODE" FontWeight="SemiBold" FontSize="11" Foreground="#FFC83B"/>
                    </Border>
                    <Border x:Name="BadgeStatus" Background="#206CCB5F" BorderBrush="#506CCB5F" BorderThickness="1" CornerRadius="12" Padding="10,4">
                        <TextBlock x:Name="TxtServiceStatus" Text="СЛУЖБА ПОДКЛЮЧЕНА" FontWeight="SemiBold" FontSize="11" Foreground="#6CCB5F"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ================= VIEW 1: DASHBOARD (HOME) ================= -->
            <Grid x:Name="ViewDashboard" Grid.Row="1">
                <Grid.RowDefinitions>
                    <!-- Top Metric Cards -->
                    <RowDefinition Height="Auto" />
                    <!-- Action & Filter Bar -->
                    <RowDefinition Height="Auto" />
                    <!-- Responsive List of Windows 11 Cards -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 3 Top Metric Hero Cards (Windows 11 Elevated Surface) -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: Outbound Firewall -->
                    <Border Grid.Column="0" Background="#1CFFFFFF" CornerRadius="8" Padding="14,12" BorderBrush="#1AFFFFFF" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" Background="#26FF99A4" BorderBrush="#40FF99A4" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="ShieldGlobe24" FontSize="18" Foreground="#FF99A4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="СЕТЕВОЙ ФИЛЬТР (FIREWALL)" FontSize="10" FontWeight="SemiBold" Foreground="#A0A0A0" />
                                <TextBlock x:Name="TxtCardOutbound" Text="БЛОКИРОВАН (BLOCK)" FontSize="14" FontWeight="Bold" Foreground="#FF99A4" Margin="0,3,0,2" />
                                <TextBlock Text="DNS (53), DHCP, WinUpdate разрешены" FontSize="11" Foreground="#888888" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Card 2: Whitelist -->
                    <Border Grid.Column="2" Background="#1CFFFFFF" CornerRadius="8" Padding="14,12" BorderBrush="#1AFFFFFF" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" Background="#264CC2FF" BorderBrush="#404CC2FF" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Apps24" FontSize="18" Foreground="#4CC2FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="БЕЛЫЙ СПИСОК (WHITELIST)" FontSize="10" FontWeight="SemiBold" Foreground="#A0A0A0" />
                                <TextBlock x:Name="TxtCardWhitelistCount" Text="0 приложений" FontSize="14" FontWeight="Bold" Foreground="#4CC2FF" Margin="0,3,0,2" />
                                <TextBlock Text="Сквозная проверка Authenticode" FontSize="11" Foreground="#888888" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Card 3: Memory Protection -->
                    <Border Grid.Column="4" Background="#1CFFFFFF" CornerRadius="8" Padding="14,12" BorderBrush="#1AFFFFFF" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" Background="#266CCB5F" BorderBrush="#406CCB5F" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="DeveloperBoard24" FontSize="18" Foreground="#6CCB5F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="ЗАЩИТА ЯДРА (ANTI-INJECTION)" FontSize="10" FontWeight="SemiBold" Foreground="#A0A0A0" />
                                <TextBlock x:Name="TxtCardInjection" Text="АКТИВЕН (ETW)" FontSize="14" FontWeight="Bold" Foreground="#6CCB5F" Margin="0,3,0,2" />
                                <TextBlock x:Name="TxtCardAttempts" Text="0 попыток заблокировано" FontSize="11" Foreground="#888888" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Command & Search Bar -->
                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Разрешенные программы" 
                               FontWeight="SemiBold" FontSize="16" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,16,0" />

                    <!-- Windows 11 Search Box with real-time filtering -->
                    <ui:TextBox x:Name="TxtSearch" Grid.Column="1" 
                                PlaceholderText="Поиск программы или пути..." 
                                Icon="{ui:SymbolIcon Symbol=Search24}"
                                Height="34" Margin="0,0,16,0" HorizontalAlignment="Stretch" MaxWidth="380"
                                TextChanged="TxtSearch_TextChanged"/>

                    <!-- Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <ui:Button x:Name="BtnAdd" Content="Добавить программу" 
                                   Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Add24}" 
                                   Margin="0,0,8,0" Click="BtnAdd_Click"/>
                        <ui:Button x:Name="BtnRefresh" Content="Обновить" 
                                   Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=ArrowCounterclockwise24}" 
                                   Click="BtnRefresh_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Application Suites (Windows 11 Responsive Cards) -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ListAppGroups">
                        <!-- Group Style: Each Suite is an Expandable Windows 11 Card -->
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="{x:Type GroupItem}">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                                    <Expander IsExpanded="True" Style="{StaticResource Win11SettingsExpanderStyle}">
                                                        <ItemsPresenter />
                                                    </Expander>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>

                        <!-- Item Template: Child Executable Row (Responsive layout, never drifts) -->
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:WhitelistEntry}">
                                <Border BorderBrush="#18FFFFFF" BorderThickness="0,0,0,1" Padding="16,10" Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: File Details & Signer Info -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF" Margin="0,0,10,0"/>
                                                <Border Background="#142B1D" BorderBrush="#1E6135" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                                    <TextBlock Text="✓ ПОДПИСАН" FontSize="10" FontWeight="SemiBold" Foreground="#6CCB5F"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding FilePath}" FontSize="11" Foreground="#888888" TextTrimming="CharacterEllipsis" MaxWidth="500"/>
                                                <TextBlock Text=" • " FontSize="11" Foreground="#555555" Margin="4,0"/>
                                                <TextBlock Text="{Binding SignerSubject}" FontSize="11" Foreground="#AAAAAA" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Right: Date and Action Button -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CreatedAt, StringFormat=\{0:dd.MM.yyyy HH:mm\}}" 
                                                       FontSize="11" Foreground="#777777" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                            <ui:Button Appearance="Subtle" Icon="{ui:SymbolIcon Symbol=Dismiss16}" 
                                                       Padding="6" Click="BtnDeleteEntry_Click" ToolTip="Удалить из Белого списка" 
                                                       Foreground="#FF99A4"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ================= VIEW 2: FIREWALL ================= -->
            <Grid x:Name="ViewFirewall" Grid.Row="1" Visibility="Collapsed">
                <Border Background="#1CFFFFFF" CornerRadius="8" Padding="22" BorderBrush="#20FFFFFF" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Параметры Сетевого Фильтра Windows Defender Firewall" FontSize="17" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,12"/>
                        <TextBlock Text="OmniEye использует прямое COM-взаимодействие с интерфейсом INetFwPolicy2 Windows." FontSize="12" Foreground="#9E9E9E" Margin="0,0,0,18"/>

                        <Border Background="#18FFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,12" BorderBrush="#1AFFFFFF" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Политика по умолчанию" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF"/>
                                <TextBlock Text="DefaultOutboundAction: BLOCK (все исходящие соединения заблокированы на уровне ядра NDIS)." FontSize="11" Foreground="#9E9E9E" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#18FFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,12" BorderBrush="#1AFFFFFF" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Системные исключения" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF"/>
                                <TextBlock Text="DNS (UDP/TCP 53), DHCP (UDP 67/68), Windows Update Services." FontSize="11" Foreground="#9E9E9E" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#18FFFFFF" CornerRadius="8" Padding="16" BorderBrush="#1AFFFFFF" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Сторожевой таймер (Self-Healing Watchdog)" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF"/>
                                <TextBlock Text="Период опроса: каждые 3000 мс. При удалении правил брандмауэра сторонним ПО правила немедленно пересоздаются." FontSize="11" Foreground="#9E9E9E" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= VIEW 3: INJECTION ================= -->
            <Grid x:Name="ViewInjection" Grid.Row="1" Visibility="Collapsed">
                <Border Background="#1CFFFFFF" CornerRadius="8" Padding="22" BorderBrush="#20FFFFFF" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Мониторинг внедрения кода и целостности процессов" FontSize="17" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,12"/>
                        <TextBlock Text="Использует Kernel ETW (Event Tracing for Windows) Microsoft-Windows-Kernel-Process." FontSize="12" Foreground="#9E9E9E" Margin="0,0,0,18"/>

                        <Border Background="#18FFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,12" BorderBrush="#1AFFFFFF" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Механизм заморозки процессов" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF"/>
                                <TextBlock Text="При обнаружении подозрительного запуска атакующий процесс немедленно останавливается через NtSuspendProcess." FontSize="11" Foreground="#9E9E9E" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#18FFFFFF" CornerRadius="8" Padding="16" BorderBrush="#1AFFFFFF" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Таймер безопасности" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF"/>
                                <TextBlock Text="Если пользователь не принял решение в окне тревоги за 60 секунд, процесс автоматически уничтожается." FontSize="11" Foreground="#9E9E9E" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= VIEW 4: SETTINGS ================= -->
            <Grid x:Name="ViewSettings" Grid.Row="1" Visibility="Collapsed">
                <Border Background="#1CFFFFFF" CornerRadius="8" Padding="22" BorderBrush="#20FFFFFF" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Параметры и режимы работы OmniEye" FontSize="17" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,12"/>
                        
                        <Border Background="#18FFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,12" BorderBrush="#1AFFFFFF" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Режим разработчика (Developer Mode)" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Разрешает откат правил брандмауэра при выходе и добавление неподписанных файлов с подтверждением." FontSize="11" Foreground="#9E9E9E" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#26FFC83B" BorderBrush="#60FFC83B" BorderThickness="1" CornerRadius="10" Padding="10,4" VerticalAlignment="Center">
                                    <TextBlock Text="АКТИВЕН" FontSize="11" FontWeight="SemiBold" Foreground="#FFC83B"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Background="#18FFFFFF" CornerRadius="8" Padding="16" BorderBrush="#1AFFFFFF" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Защищенная база данных" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF"/>
                                <TextBlock Text="Путь: C:\ProgramData\OmniEye\config.db" FontSize="11" Foreground="#9E9E9E" Margin="0,4,0,0"/>
                                <TextBlock Text="Алгоритм: AES-256 (SQLCipher) + аппаратный ключ Windows DPAPI (LocalMachine)." FontSize="11" Foreground="#6CCB5F" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bottom Status Footer -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="OmniEye Zero-Trust Engine • Windows 11 Fluent Design" 
                           FontSize="11" Foreground="#707070" VerticalAlignment="Center" />

                <ui:Button x:Name="BtnMinimizeToTray" Grid.Column="1" Content="Свернуть в трей" 
                           Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=ArrowMinimize24}" Click="BtnMinimizeToTray_Click" />
            </Grid>
        </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
