<Window x:Class="OmniEyeTray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OmniEye — Консоль Zero-Trust Защиты" 
        Height="640" Width="1000"
        MinHeight="540" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#202020"
        Foreground="#FFFFFF"
        FontFamily="Segoe UI Variable, Segoe UI, -apple-system, BlinkMacSystemFont, sans-serif">

    <Window.Resources>
        <!-- Windows 11 Fluent Button Styles -->
        <Style x:Key="FluentButton" TargetType="Button">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#383838"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#383838"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#454545"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#252525"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#303030"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentPrimaryButton" TargetType="Button" BasedOn="{StaticResource FluentButton}">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="BorderBrush" Value="#1B87DE"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#1886D9"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#2B95E8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#005A9E"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#004578"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentDangerButton" TargetType="Button" BasedOn="{StaticResource FluentButton}">
            <Setter Property="Background" Value="#2D1C20"/>
            <Setter Property="BorderBrush" Value="#5E262E"/>
            <Setter Property="Foreground" Value="#FF99A4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#3D2026"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#752D37"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#221518"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#4A1D23"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 Search Input Style -->
        <Style x:Key="FluentSearchTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#262626"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="CaretBrush" Value="#4CC2FF"/>
            <Setter Property="BorderBrush" Value="#383838"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4A4A4A"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4CC2FF"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="1,1,1,2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Windows 11 Header Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#2B2B2B" CornerRadius="8" Width="42" Height="42" Margin="0,0,12,0" 
                        BorderBrush="#383838" BorderThickness="1">
                    <TextBlock Text="🛡️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="OmniEye" FontWeight="Bold" FontSize="18" Foreground="#FFFFFF" />
                        <TextBlock Text="Zero-Trust" FontWeight="Normal" FontSize="18" Foreground="#4CC2FF" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="Защита от эксфильтрации данных, изоляция сетевого трафика и мониторинг инъекций" 
                               FontSize="11" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Windows 11 Badges (Pills) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="BadgeDevMode" Background="#332508" BorderBrush="#6E4D0C" BorderThickness="1" CornerRadius="12" Padding="10,3" Margin="0,0,8,0">
                    <TextBlock x:Name="TxtDevMode" Text="DEVELOPER MODE" FontWeight="SemiBold" FontSize="11" Foreground="#FFC83B"/>
                </Border>
                <Border x:Name="BadgeStatus" Background="#133821" BorderBrush="#1E6135" BorderThickness="1" CornerRadius="12" Padding="10,3">
                    <TextBlock x:Name="TxtServiceStatus" Text="СЛУЖБА ПОДКЛЮЧЕНА" FontWeight="SemiBold" FontSize="11" Foreground="#6CCB5F"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Windows 11 Surface Metric Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: Outbound Firewall -->
            <Border Grid.Column="0" Background="#2B2B2B" CornerRadius="8" Padding="14" BorderBrush="#383838" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="СЕТЕВОЙ ФИЛЬТР (FIREWALL)" FontSize="11" FontWeight="SemiBold" Foreground="#A0A0A0" />
                    <TextBlock x:Name="TxtCardOutbound" Text="БЛОКИРОВАН (BLOCK)" FontSize="15" FontWeight="Bold" Foreground="#FF99A4" Margin="0,4,0,2" />
                    <TextBlock Text="DNS (53), DHCP (67/68), WinUpdate разрешены" FontSize="11" Foreground="#808080" />
                </StackPanel>
            </Border>

            <!-- Card 2: Whitelist -->
            <Border Grid.Column="2" Background="#2B2B2B" CornerRadius="8" Padding="14" BorderBrush="#383838" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="БЕЛЫЙ СПИСОК (WHITELIST)" FontSize="11" FontWeight="SemiBold" Foreground="#A0A0A0" />
                    <TextBlock x:Name="TxtCardWhitelistCount" Text="0 приложений" FontSize="15" FontWeight="Bold" Foreground="#4CC2FF" Margin="0,4,0,2" />
                    <TextBlock Text="Сквозная проверка WinVerifyTrust Authenticode" FontSize="11" Foreground="#808080" />
                </StackPanel>
            </Border>

            <!-- Card 3: Memory Protection -->
            <Border Grid.Column="4" Background="#2B2B2B" CornerRadius="8" Padding="14" BorderBrush="#383838" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="ЗАЩИТА ПАМЯТИ (ANTI-INJECTION)" FontSize="11" FontWeight="SemiBold" Foreground="#A0A0A0" />
                    <TextBlock x:Name="TxtCardInjection" Text="АКТИВЕН (ETW + NtSuspend)" FontSize="15" FontWeight="Bold" Foreground="#6CCB5F" Margin="0,4,0,2" />
                    <TextBlock x:Name="TxtCardAttempts" Text="0 подозрительных попыток заблокировано" FontSize="11" Foreground="#808080" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Command & Filter Bar -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="РАЗРЕШЕННЫЕ ПРИЛОЖЕНИЯ" 
                       FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,16,0" />

            <!-- Search Filter Box -->
            <TextBox x:Name="TxtSearch" Grid.Column="1" Style="{StaticResource FluentSearchTextBox}" 
                     Height="30" TextChanged="TxtSearch_TextChanged" Margin="0,0,12,0"/>
            <TextBlock Grid.Column="1" Text="🔍 Поиск программы..." FontSize="11" Foreground="#707070" 
                       IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,0,0"
                       Visibility="{Binding Text.IsEmpty, ElementName=TxtSearch, Converter={x:Null}}"/>

            <!-- Action Buttons -->
            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <Button x:Name="BtnAdd" Content="+ Добавить программу" 
                        Style="{StaticResource FluentPrimaryButton}" Margin="0,0,8,0" Click="BtnAdd_Click"/>
                <Button x:Name="BtnRemove" Content="Удалить выбранное" 
                        Style="{StaticResource FluentDangerButton}" Margin="0,0,8,0" Click="BtnRemove_Click"/>
                <Button x:Name="BtnRefresh" Content="Обновить" 
                        Style="{StaticResource FluentButton}" Click="BtnRefresh_Click"/>
            </StackPanel>
        </Grid>

        <!-- Whitelist DataGrid (Windows 11 Fluent Table) -->
        <Border Grid.Row="3" Background="#2B2B2B" CornerRadius="8" BorderBrush="#383838" BorderThickness="1" Margin="0,0,0,14">
            <DataGrid x:Name="DgWhitelist" AutoGenerateColumns="False" 
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      IsReadOnly="True" SelectionMode="Single"
                      Background="Transparent" RowBackground="#2B2B2B" 
                      AlternatingRowBackground="#262626"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#333333"
                      HeadersVisibility="Column" BorderThickness="0"
                      Foreground="#FFFFFF">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#202020" />
                        <Setter Property="Foreground" Value="#A0A0A0" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="BorderBrush" Value="#383838" />
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="12,7" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#173B5E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>

                <!-- Grouping Style (Windows 11 Expander Card) -->
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="{x:Type GroupItem}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type GroupItem}">
                                            <Expander IsExpanded="True" Background="Transparent" BorderThickness="0" Margin="0,2,0,4" Foreground="#A0A0A0">
                                                <Expander.Header>
                                                    <Border Background="#242424" CornerRadius="6" Padding="10,5" Margin="0,1" BorderBrush="#353535" BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="📁" FontSize="12" Margin="0,0,6,0"/>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#4CC2FF" FontSize="12"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Border Background="#1C1C1C" CornerRadius="10" Padding="8,2" BorderBrush="#333333" BorderThickness="1">
                                                                    <TextBlock Text="{Binding ItemCount, StringFormat='{}{0} файлов'}" 
                                                                               FontSize="10" FontWeight="SemiBold" Foreground="#6CCB5F"/>
                                                                </Border>
                                                                <Button Content="Удалить группу" Click="BtnDeleteGroup_Click" 
                                                                        Margin="8,0,0,0" Padding="8,2" FontSize="10" FontWeight="SemiBold"
                                                                        Background="#2A1B1E" Foreground="#FF99A4" BorderBrush="#5E262E" BorderThickness="1"
                                                                        Cursor="Hand">
                                                                    <Button.Resources>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="CornerRadius" Value="4"/>
                                                                        </Style>
                                                                    </Button.Resources>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </Expander.Header>
                                                <ItemsPresenter />
                                            </Expander>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </DataGrid.GroupStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ПРОГРАММА" Binding="{Binding FileName}" Width="170" FontWeight="SemiBold"/>
                    <DataGridTemplateColumn Header="ПОДПИСЬ AUTHENTICODE" Width="175">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#133821" BorderBrush="#1E6135" BorderThickness="1" CornerRadius="10" Padding="8,2"
                                            Visibility="{Binding IsSigned, Converter={x:Null}}">
                                        <TextBlock Text="✓ ПОДПИСАН" FontSize="10" FontWeight="SemiBold" Foreground="#6CCB5F"/>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="СЕРТИФИКАТ (SUBJECT)" Binding="{Binding SignerSubject}" Width="230" />
                    <DataGridTextColumn Header="ПОЛНЫЙ ПУТЬ" Binding="{Binding FilePath}" Width="*" />
                    <DataGridTextColumn Header="ДОБАВЛЕНО" Binding="{Binding CreatedAt, StringFormat=\{0:dd.MM.yyyy HH:mm\}}" Width="130" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Windows 11 Footer Status Bar -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="База данных зашифрована AES-256 (SQLCipher + DPAPI LocalMachine). Эксклюзивная блокировка активна." 
                       FontSize="11" Foreground="#707070" VerticalAlignment="Center" />

            <Button x:Name="BtnMinimizeToTray" Grid.Column="1" Content="Свернуть в трей" 
                    Style="{StaticResource FluentButton}" Click="BtnMinimizeToTray_Click" />
        </Grid>
    </Grid>
</Window>
