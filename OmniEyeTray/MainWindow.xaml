<ui:FluentWindow x:Class="OmniEyeTray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:models="clr-namespace:OmniEye.Core.Models;assembly=OmniEye.Core"
        Title="{DynamicResource App_Title}" 
        Height="720" Width="1100"
        MinHeight="580" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Windows 11 Navigation Item Style -->
        <Style x:Key="Win11NavItem" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Left Blue Selection Indicator Pill (Win11 Signature) -->
                                <Border x:Name="Indicator" Width="3" Height="18" Background="#4CC2FF" CornerRadius="1.5" 
                                        HorizontalAlignment="Left" Visibility="Collapsed" Margin="-6,0,8,0"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#12FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#1AFFFFFF"/>
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 SettingsExpander Header Template -->
        <ControlTemplate x:Key="Win11SettingsExpanderHeaderTemplate" TargetType="ToggleButton">
            <Border x:Name="HBorder" Background="#242424" Padding="16,12" CornerRadius="7" 
                    BorderBrush="#25FFFFFF" BorderThickness="0" HorizontalAlignment="Stretch">
                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Icon Container -->
                    <Border Grid.Column="0" Background="#18FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" 
                            CornerRadius="6" Width="36" Height="36" Margin="0,0,14,0" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Folder24" FontSize="18" Foreground="#4CC2FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Suite Name and Details -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{DynamicResource Dash_GroupSubtitle}" FontSize="11" Foreground="#888888" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Count pill -->
                    <Border Grid.Column="2" Background="#142B1D" BorderBrush="#1E6135" BorderThickness="1" 
                            CornerRadius="10" Padding="8,2" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding ItemCount, StringFormat='{}{0} files'}" 
                                   FontSize="11" FontWeight="SemiBold" Foreground="#6CCB5F"/>
                    </Border>

                    <!-- Delete whole group button -->
                    <ui:Button Grid.Column="3" Content="{DynamicResource Action_DeleteGroup}" Click="BtnDeleteGroup_Click" 
                               Appearance="Danger" Margin="0,0,12,0" Padding="10,4" FontSize="11" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <!-- Clean Windows 11 Chevron -->
                    <ui:SymbolIcon Grid.Column="4" x:Name="Chevron" Symbol="ChevronDown24" FontSize="14" Foreground="#A0A0A0"
                                   VerticalAlignment="Center" Margin="4,0,8,0" RenderTransformOrigin="0.5,0.5">
                        <ui:SymbolIcon.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </ui:SymbolIcon.RenderTransform>
                    </ui:SymbolIcon>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="HBorder" Property="Background" Value="#2A2A2A"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="HBorder" Property="CornerRadius" Value="7,7,0,0"/>
                    <Setter TargetName="HBorder" Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter TargetName="Chevron" Property="RenderTransform">
                        <Setter.Value>
                            <RotateTransform Angle="180"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Windows 11 SettingsExpander Template -->
        <ControlTemplate x:Key="Win11SettingsExpanderTemplate" TargetType="Expander">
            <Border Background="#202020" BorderBrush="#25FFFFFF" BorderThickness="1" 
                    CornerRadius="8" Margin="0,0,0,10" HorizontalAlignment="Stretch">
                <Grid HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Custom Header Toggle Button (Forced Stretch & Style Reset) -->
                    <ToggleButton x:Name="ExpanderHeaderBtn"
                                  Style="{x:Null}"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"
                                  Focusable="False"
                                  IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                  Template="{StaticResource Win11SettingsExpanderHeaderTemplate}"
                                  Cursor="Hand"/>

                    <!-- Child Items Container -->
                    <Border Grid.Row="1" x:Name="ExpandContentBorder" Visibility="Collapsed" 
                            Background="#1A1A1A" CornerRadius="0,0,7,7" Padding="4,4" HorizontalAlignment="Stretch">
                        <ContentPresenter HorizontalAlignment="Stretch"/>
                    </Border>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsExpanded" Value="True">
                    <Setter TargetName="ExpandContentBorder" Property="Visibility" Value="Visible"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="Win11SettingsExpanderStyle" TargetType="Expander">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template" Value="{StaticResource Win11SettingsExpanderTemplate}"/>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Windows 11 Fluent Native TitleBar -->
        <ui:TitleBar Grid.Row="0" x:Name="AppTitleBar" 
                     Title="{DynamicResource App_Title}" 
                     ShowMaximize="True" ShowMinimize="True" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left Sidebar (Windows 11 Settings Navigation) -->
                <ColumnDefinition Width="260" />
                <!-- Main Content Area -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================= SIDEBAR ================= -->
            <Border Grid.Column="0" Background="#141414" BorderBrush="#20FFFFFF" BorderThickness="0,0,1,0" Padding="14,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- App Identity (Win11 Settings Profile Style) -->
                <StackPanel Grid.Row="0" Margin="4,0,4,22">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#0078D4" CornerRadius="8" Width="40" Height="40" Margin="0,0,12,0"
                                BorderBrush="#30FFFFFF" BorderThickness="1">
                            <ui:SymbolIcon Symbol="Shield24" FontSize="20" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="OmniEye" FontWeight="SemiBold" FontSize="16" Foreground="#FFFFFF" />
                            <TextBlock Text="{DynamicResource App_ZeroTrust}" FontSize="11" Foreground="#8E8E8E" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Menu (Windows 11 Settings Sidebar Items) -->
                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="NavDashboard" Style="{StaticResource Win11NavItem}" IsChecked="True" Click="NavDashboard_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Home24" FontSize="16" Margin="0,0,12,0" Foreground="#4CC2FF" />
                            <TextBlock Text="{DynamicResource Nav_Dashboard}" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavFirewall" Style="{StaticResource Win11NavItem}" Click="NavFirewall_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ShieldGlobe24" FontSize="16" Margin="0,0,12,0" Foreground="#A0A0A0" />
                            <TextBlock Text="{DynamicResource Nav_Firewall}" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavDpiBypass" Style="{StaticResource Win11NavItem}" Click="NavDpiBypass_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="GlobeSearch24" FontSize="16" Margin="0,0,12,0" Foreground="#A0A0A0" />
                            <TextBlock Text="{DynamicResource Nav_DpiBypass}" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavInjection" Style="{StaticResource Win11NavItem}" Click="NavInjection_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="DeveloperBoard24" FontSize="16" Margin="0,0,12,0" Foreground="#A0A0A0" />
                            <TextBlock Text="{DynamicResource Nav_Injection}" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource Win11NavItem}" Click="NavSettings_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Settings24" FontSize="16" Margin="0,0,12,0" Foreground="#A0A0A0" />
                            <TextBlock Text="{DynamicResource Nav_Settings}" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Sidebar Footer -->
                <StackPanel Grid.Row="2" Margin="2,0,2,0">
                    <Border Background="#1CFFFFFF" CornerRadius="8" Padding="12,10" BorderBrush="#20FFFFFF" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Key20" FontSize="16" Foreground="#6CCB5F" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{DynamicResource Storage_Aes256}" FontSize="11" FontWeight="SemiBold" Foreground="#6CCB5F"/>
                                <TextBlock Text="{DynamicResource Storage_Provider}" FontSize="10" Foreground="#888888" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= MAIN CONTENT ================= -->
        <Grid Grid.Column="1" Margin="26,18,26,16">
            <Grid.RowDefinitions>
                <!-- Top Breadcrumb & Status Badges -->
                <RowDefinition Height="Auto" />
                <!-- Dynamic Content (Pages) -->
                <RowDefinition Height="*" />
                <!-- Bottom Bar -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Header (Windows 11 Settings Style) -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="BtnBackToFirewall" Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=ArrowLeft24}"
                               Click="BtnBackToFirewall_Click" Visibility="Collapsed" Margin="0,0,12,0" VerticalAlignment="Center" Height="36" Width="40"
                               ToolTip="{DynamicResource Nav_BackToFirewall}"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtPageTitle" Text="Главная" FontWeight="SemiBold" FontSize="26" Foreground="#FFFFFF"/>
                        <TextBlock x:Name="TxtPageSubtitle" Text="Мониторинг исходящего сетевого трафика и изоляция процессов" 
                                   FontSize="12" Foreground="#9E9E9E" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Status Badges (Windows 11 Pills) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="BadgeDevMode" Background="#26FFC83B" BorderBrush="#60FFC83B" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,8,0">
                        <TextBlock x:Name="TxtDevMode" Text="DEVELOPER MODE" FontWeight="SemiBold" FontSize="11" Foreground="#FFC83B"/>
                    </Border>
                    <Border x:Name="BadgeStatus" Background="#206CCB5F" BorderBrush="#506CCB5F" BorderThickness="1" CornerRadius="12" Padding="10,4">
                        <TextBlock x:Name="TxtServiceStatus" Text="СЛУЖБА ПОДКЛЮЧЕНА" FontWeight="SemiBold" FontSize="11" Foreground="#6CCB5F"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ================= VIEW 1: DASHBOARD (HOME) ================= -->
            <Grid x:Name="ViewDashboard" Grid.Row="1">
                <Grid.RowDefinitions>
                    <!-- Top Metric Cards -->
                    <RowDefinition Height="Auto" />
                    <!-- Action & Filter Bar -->
                    <RowDefinition Height="Auto" />
                    <!-- Responsive List of Windows 11 Cards -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 3 Top Metric Hero Cards (Windows 11 Elevated Surface) -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: Outbound Firewall -->
                    <Border Grid.Column="0" Background="#1CFFFFFF" CornerRadius="8" Padding="14,12" BorderBrush="#1AFFFFFF" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" Background="#26FF99A4" BorderBrush="#40FF99A4" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="ShieldGlobe24" FontSize="18" Foreground="#FF99A4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Metric_FirewallTitle}" FontSize="10" FontWeight="SemiBold" Foreground="#A0A0A0" />
                                <TextBlock x:Name="TxtCardOutbound" Text="БЛОКИРОВАН (BLOCK)" FontSize="14" FontWeight="Bold" Foreground="#FF99A4" Margin="0,3,0,2" />
                                <TextBlock Text="{DynamicResource Metric_FirewallDesc}" FontSize="11" Foreground="#888888" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Card 2: Whitelist -->
                    <Border Grid.Column="2" Background="#1CFFFFFF" CornerRadius="8" Padding="14,12" BorderBrush="#1AFFFFFF" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" Background="#264CC2FF" BorderBrush="#404CC2FF" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Apps24" FontSize="18" Foreground="#4CC2FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Metric_WhitelistTitle}" FontSize="10" FontWeight="SemiBold" Foreground="#A0A0A0" />
                                <TextBlock x:Name="TxtCardWhitelistCount" Text="0 apps" FontSize="14" FontWeight="Bold" Foreground="#4CC2FF" Margin="0,3,0,2" />
                                <TextBlock Text="{DynamicResource Metric_WhitelistDesc}" FontSize="11" Foreground="#888888" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Card 3: Memory Protection -->
                    <Border Grid.Column="4" Background="#1CFFFFFF" CornerRadius="8" Padding="14,12" BorderBrush="#1AFFFFFF" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" Background="#266CCB5F" BorderBrush="#406CCB5F" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="DeveloperBoard24" FontSize="18" Foreground="#6CCB5F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Metric_InjectionTitle}" FontSize="10" FontWeight="SemiBold" Foreground="#A0A0A0" />
                                <TextBlock x:Name="TxtCardInjection" Text="ACTIVE (ETW)" FontSize="14" FontWeight="Bold" Foreground="#6CCB5F" Margin="0,3,0,2" />
                                <TextBlock x:Name="TxtCardAttempts" Text="0 attempts blocked" FontSize="11" Foreground="#888888" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Command & Search Bar -->
                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{DynamicResource Dash_AllowedApps}" 
                               FontWeight="SemiBold" FontSize="16" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,16,0" />

                    <!-- Windows 11 Search Box with real-time filtering -->
                    <ui:TextBox x:Name="TxtSearch" Grid.Column="1" 
                                PlaceholderText="{DynamicResource Dash_SearchPlaceholder}" 
                                Icon="{ui:SymbolIcon Symbol=Search24}"
                                Height="34" Margin="0,0,16,0" HorizontalAlignment="Stretch" MaxWidth="380"
                                TextChanged="TxtSearch_TextChanged"/>

                    <!-- Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <ui:Button x:Name="BtnAdd" Content="{DynamicResource Action_AddApp}" 
                                   Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Add24}" 
                                   Margin="0,0,8,0" Click="BtnAdd_Click"/>
                        <ui:Button x:Name="BtnRefresh" Content="{DynamicResource Action_Refresh}" 
                                   Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=ArrowCounterclockwise24}" 
                                   Click="BtnRefresh_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Application Suites (Windows 11 Responsive Cards) -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False" PanningMode="Both" CanContentScroll="False">
                    <ItemsControl x:Name="ListAppGroups" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <!-- Group Style: Each Suite is an Expandable Windows 11 Card -->
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="{x:Type GroupItem}">
                                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                             <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                                    <Expander IsExpanded="True" 
                                                              Style="{StaticResource Win11SettingsExpanderStyle}"
                                                              HorizontalAlignment="Stretch"
                                                              HorizontalContentAlignment="Stretch">
                                                        <ItemsPresenter HorizontalAlignment="Stretch" />
                                                    </Expander>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>

                        <!-- Item Template: Child Executable Row (Responsive layout with hover feedback) -->
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:WhitelistEntry}">
                                <Border Margin="4,2" CornerRadius="6" Padding="12,8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#0FFFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Executable File Icon Badge -->
                                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" 
                                                Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"
                                                VerticalAlignment="Center" Margin="0,0,12,0">
                                            <ui:SymbolIcon Symbol="Document20" FontSize="16" Foreground="#99D5FF" 
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Left: File Details & Signer Info (Responsive) -->
                                        <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12.5" Foreground="#FFFFFF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <Border Background="#142B1D" BorderBrush="#1E6135" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource App_Signed}" FontSize="10" FontWeight="SemiBold" Foreground="#6CCB5F"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Grid.Row="1" FontSize="11" Foreground="#888888" TextTrimming="CharacterEllipsis" Margin="0,3,0,0">
                                                <Run Text="{Binding FilePath, Mode=OneWay}" Foreground="#888888"/>
                                                <Run Text="  •  " Foreground="#555555"/>
                                                <Run Text="{Binding SignerSubject, Mode=OneWay}" Foreground="#AAAAAA"/>
                                            </TextBlock>
                                        </Grid>

                                        <!-- Right: Date and Action Button -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CreatedAt, StringFormat=\{0:dd.MM.yyyy HH:mm\}}" 
                                                       FontSize="11" Foreground="#777777" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon Symbol=Dismiss16}" 
                                                       Padding="6" Click="BtnDeleteEntry_Click" ToolTip="{DynamicResource Action_DeleteEntryTooltip}" 
                                                       Foreground="#FF99A4" Cursor="Hand"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ================= VIEW 2: FIREWALL ================= -->
            <Grid x:Name="ViewFirewall" Grid.Row="1" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="{DynamicResource Firewall_Header}" FontSize="17" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                        <TextBlock Text="{DynamicResource Firewall_HeaderDesc}" FontSize="12" Foreground="#9E9E9E" Margin="0,0,0,14"/>

                        <!-- Policy Card -->
                        <Border Background="#1CFFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,12" BorderBrush="#20FFFFFF" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{DynamicResource Firewall_PolicyTitle}" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF"/>
                                    <TextBlock x:Name="TxtFirewallPolicyDesc" 
                                               Text="DefaultOutboundAction: BLOCK" 
                                               FontSize="11" Foreground="#9E9E9E" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border x:Name="BadgeFirewallPolicy" Background="#26FF99A4" BorderBrush="#60FF99A4" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtFirewallPolicyBadge" Text="BLOCKED (BLOCK)" FontWeight="SemiBold" FontSize="11" Foreground="#FF99A4"/>
                                    </Border>
                                    
                                    <ui:Button x:Name="BtnTogglePolicy" Content="Allow All" 
                                               Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=ArrowSync24}" 
                                               Click="BtnTogglePolicy_Click" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- System Exceptions Card -->
                        <Border Background="#18FFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,12" BorderBrush="#1AFFFFFF" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Firewall_ExceptionsTitle}" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF"/>
                                <TextBlock Text="{DynamicResource Firewall_ExceptionsDesc}" FontSize="11" Foreground="#9E9E9E" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Watchdog Card -->
                        <Border Background="#18FFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,12" BorderBrush="#1AFFFFFF" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Firewall_WatchdogTitle}" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF"/>
                                <TextBlock Text="{DynamicResource Firewall_WatchdogDesc}" FontSize="11" Foreground="#9E9E9E" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Active Network Connections Monitor Entry Card -->
                        <Border x:Name="CardOpenNetworkMonitor" CornerRadius="8" Padding="18,16" 
                                BorderBrush="#24FFFFFF" BorderThickness="1" Cursor="Hand" Margin="0,0,0,12"
                                MouseLeftButtonUp="CardOpenNetworkMonitor_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#1CFFFFFF"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#25FFFFFF"/>
                                            <Setter Property="BorderBrush" Value="#404CC2FF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Glowing Icon Badge -->
                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Background="#264CC2FF" BorderBrush="#404CC2FF" BorderThickness="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="DesktopPulse24" FontSize="22" Foreground="#4CC2FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Title, Description & Live Counter -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource NetMon_Title}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="{DynamicResource NetMon_Subtitle}" FontSize="11.5" Foreground="#9E9E9E" Margin="0,3,0,6" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#1A4CC2FF" BorderBrush="#404CC2FF" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="0,0,8,0">
                                            <TextBlock x:Name="TxtFirewallSocketsCount" Text="Active sockets: 0" FontWeight="SemiBold" FontSize="11" Foreground="#4CC2FF"/>
                                        </Border>
                                        <Border Background="#142B1D" BorderBrush="#1E6135" BorderThickness="1" CornerRadius="10" Padding="8,2">
                                            <TextBlock Text="LIVE TELEMETRY" FontWeight="SemiBold" FontSize="10.5" Foreground="#6CCB5F"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Open Subpage Button -->
                                <ui:Button x:Name="BtnOpenNetMonSubpage" Grid.Column="2" 
                                           Content="{DynamicResource NetMon_CardOpen}" 
                                           Appearance="Primary" Icon="{ui:SymbolIcon Symbol=ArrowRight24}"
                                           Click="BtnOpenNetMonSubpage_Click" 
                                           VerticalAlignment="Center" Height="38" Padding="16,0"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ================= VIEW: NETWORK MONITOR (SUBPAGE) ================= -->
            <Grid x:Name="ViewNetworkMonitor" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Filter & Search Controls -->
                <Border Grid.Row="0" Background="#18FFFFFF" CornerRadius="8" Padding="12,10" Margin="0,0,0,10" BorderBrush="#20FFFFFF" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search -->
                        <ui:TextBox x:Name="TxtConnectionSearch" Grid.Column="0"
                                    PlaceholderText="{DynamicResource NetMon_SearchPlaceholder}"
                                    TextChanged="TxtConnectionSearch_TextChanged"
                                    Icon="{ui:SymbolIcon Symbol=Search24}"
                                    Height="34" Margin="0,0,10,0" VerticalAlignment="Center"/>

                        <!-- Protocol Filter -->
                        <ComboBox x:Name="CmbProtocolFilter" Grid.Column="1" Width="130" Height="34" Margin="0,0,8,0"
                                  SelectionChanged="CmbProtocolFilter_SelectionChanged" VerticalAlignment="Center">
                            <ComboBoxItem Content="{DynamicResource NetMon_FilterAll}" IsSelected="True" Tag="ALL"/>
                            <ComboBoxItem Content="{DynamicResource NetMon_FilterTcp}" Tag="TCP"/>
                            <ComboBoxItem Content="{DynamicResource NetMon_FilterUdp}" Tag="UDP"/>
                        </ComboBox>

                        <!-- Status Filter -->
                        <ComboBox x:Name="CmbStatusFilter" Grid.Column="2" Width="145" Height="34" Margin="0,0,10,0"
                                  SelectionChanged="CmbStatusFilter_SelectionChanged" VerticalAlignment="Center">
                            <ComboBoxItem Content="{DynamicResource NetMon_FilterStatusAll}" IsSelected="True" Tag="ALL"/>
                            <ComboBoxItem Content="{DynamicResource NetMon_StatusWhitelisted}" Tag="WHITELISTED"/>
                            <ComboBoxItem Content="{DynamicResource NetMon_StatusBlocked}" Tag="BLOCKED"/>
                            <ComboBoxItem Content="{DynamicResource NetMon_StatusException}" Tag="EXCEPTION"/>
                        </ComboBox>

                        <!-- Active Sockets Badge -->
                        <Border Grid.Column="3" Background="#1A4CC2FF" BorderBrush="#404CC2FF" BorderThickness="1" CornerRadius="10" Padding="10,4" Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtConnectionsCount" Text="Active sockets: 0" FontWeight="SemiBold" FontSize="11" Foreground="#4CC2FF"/>
                        </Border>

                        <!-- Refresh Button -->
                        <ui:Button x:Name="BtnRefreshConnections" Grid.Column="4" Content="{DynamicResource NetMon_BtnRefresh}"
                                   Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=ArrowSync24}"
                                   Click="BtnRefreshConnections_Click" VerticalAlignment="Center" Height="34"/>
                    </Grid>
                </Border>

                <!-- Full Connections DataGrid -->
                <Border Grid.Row="1" Background="#18FFFFFF" CornerRadius="8" Padding="0" BorderBrush="#20FFFFFF" BorderThickness="1">
                    <DataGrid x:Name="DgConnections" AutoGenerateColumns="False" 
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                              Background="Transparent" RowBackground="#14FFFFFF" 
                              AlternatingRowBackground="#0AFFFFFF"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#14FFFFFF"
                              HeadersVisibility="Column" BorderThickness="0"
                              Foreground="#FFFFFF" SelectionMode="Single"
                              ScrollViewer.CanContentScroll="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#1E1E1E"/>
                                <Setter Property="Foreground" Value="#A0A0A0"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#25FFFFFF"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <!-- Process -->
                            <DataGridTemplateColumn Header="{DynamicResource NetMon_ColProcess}" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding ProcessPath}">
                                            <ui:SymbolIcon Symbol="AppGeneric24" FontSize="16" Foreground="#4CC2FF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" MaxWidth="145"/>
                                                <TextBlock Text="{Binding ProcessId, StringFormat='PID: {0}'}" FontSize="10" Foreground="#8E8E8E"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Protocol Badge -->
                            <DataGridTemplateColumn Header="{DynamicResource NetMon_ColProtocol}" Width="75">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding ProtocolBadgeBackground}" BorderBrush="{Binding ProtocolBadgeBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProtocolName}" FontSize="10" FontWeight="Bold" Foreground="{Binding ProtocolBadgeForeground}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Local Endpoint -->
                            <DataGridTemplateColumn Header="{DynamicResource NetMon_ColLocal}" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LocalEndpoint}" FontFamily="Consolas, Segoe UI" FontSize="11" Foreground="#D0D0D0" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Remote Endpoint -->
                            <DataGridTemplateColumn Header="{DynamicResource NetMon_ColRemote}" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RemoteEndpoint}" FontFamily="Consolas, Segoe UI" FontSize="11" Foreground="#CCCCCC" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- State -->
                            <DataGridTemplateColumn Header="{DynamicResource NetMon_ColState}" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding State}" FontSize="11" Foreground="#A8A8A8" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Policy Status Badge -->
                            <DataGridTemplateColumn Header="{DynamicResource NetMon_ColStatus}" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusBadgeBackground}" BorderBrush="{Binding StatusBadgeBorder}" BorderThickness="1" CornerRadius="8" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding StatusBadgeForeground}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Executable Path -->
                            <DataGridTemplateColumn Header="{DynamicResource NetMon_ColPath}" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ProcessPath}" FontSize="11" Foreground="#8E8E8E" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProcessPath}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Quick Whitelist Action -->
                            <DataGridTemplateColumn Header="{DynamicResource NetMon_ColAction}" Width="135">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:Button Content="{DynamicResource NetMon_ActionAdd}" 
                                                   FontSize="10" Padding="8,3" Height="26"
                                                   Appearance="Secondary"
                                                   Visibility="{Binding CanAddToWhitelist, Converter={StaticResource BoolToVisConverter}}"
                                                   Click="BtnAddConnectionToWhitelist_Click"
                                                   Tag="{Binding ProcessPath}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Bottom Telemetry Bar -->
                <Border Grid.Row="2" Background="#14FFFFFF" CornerRadius="6" Padding="12,8" Margin="0,8,0,0" BorderBrush="#16FFFFFF" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtStatTcp" Text="TCP: 0" FontSize="11" Foreground="#4CC2FF" Margin="0,0,14,0"/>
                            <TextBlock x:Name="TxtStatUdp" Text="UDP: 0" FontSize="11" Foreground="#6CCB5F" Margin="0,0,14,0"/>
                            <TextBlock x:Name="TxtStatWhitelisted" Text="Whitelisted: 0" FontSize="11" Foreground="#6CCB5F" Margin="0,0,14,0"/>
                            <TextBlock x:Name="TxtStatBlocked" Text="Blocked: 0" FontSize="11" Foreground="#FF99A4" Margin="0,0,14,0"/>
                            <TextBlock x:Name="TxtStatExceptions" Text="System: 0" FontSize="11" Foreground="#FFC83B"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource NetMon_AutoRefresh}" FontSize="11" Foreground="#888888"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= VIEW 3: INJECTION ================= -->
            <Grid x:Name="ViewInjection" Grid.Row="1" Visibility="Collapsed">
                <Border Background="#1CFFFFFF" CornerRadius="8" Padding="22" BorderBrush="#20FFFFFF" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Injection_Header}" FontSize="17" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,12"/>
                        <TextBlock Text="{DynamicResource Injection_HeaderDesc}" FontSize="12" Foreground="#9E9E9E" Margin="0,0,0,18"/>

                        <Border Background="#18FFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,12" BorderBrush="#1AFFFFFF" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Injection_FreezeTitle}" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF"/>
                                <TextBlock Text="{DynamicResource Injection_FreezeDesc}" FontSize="11" Foreground="#9E9E9E" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#18FFFFFF" CornerRadius="8" Padding="16" BorderBrush="#1AFFFFFF" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Injection_TimerTitle}" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF"/>
                                <TextBlock Text="{DynamicResource Injection_TimerDesc}" FontSize="11" Foreground="#9E9E9E" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= VIEW 4: SETTINGS ================= -->
            <Grid x:Name="ViewSettings" Grid.Row="1" Visibility="Collapsed">
                <Border Background="#1CFFFFFF" CornerRadius="8" Padding="22" BorderBrush="#20FFFFFF" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings_Header}" FontSize="17" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,12"/>
                        
                        <!-- Language Selection Card -->
                        <Border Background="#18FFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,12" BorderBrush="#1AFFFFFF" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Settings_LanguageTitle}" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF"/>
                                    <TextBlock Text="{DynamicResource Settings_LanguageDesc}" FontSize="11" Foreground="#9E9E9E" Margin="0,4,0,0"/>
                                </StackPanel>
                                <ComboBox x:Name="CmbLanguage" Grid.Column="1" Width="180" Height="36" VerticalAlignment="Center"
                                          SelectionChanged="CmbLanguage_SelectionChanged"
                                          DisplayMemberPath="DisplayName" SelectedValuePath="Code" />
                            </Grid>
                        </Border>

                        <Border Background="#18FFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,12" BorderBrush="#1AFFFFFF" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings_DevModeTitle}" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF"/>
                                    <TextBlock Text="{DynamicResource Settings_DevModeDesc}" FontSize="11" Foreground="#9E9E9E" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#26FFC83B" BorderBrush="#60FFC83B" BorderThickness="1" CornerRadius="10" Padding="10,4" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Status_Active}" FontSize="11" FontWeight="SemiBold" Foreground="#FFC83B"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Background="#18FFFFFF" CornerRadius="8" Padding="16" BorderBrush="#1AFFFFFF" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Settings_DbTitle}" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF"/>
                                <TextBlock Text="{DynamicResource Settings_DbPath}" FontSize="11" Foreground="#9E9E9E" Margin="0,4,0,0"/>
                                <TextBlock Text="{DynamicResource Settings_DbCrypto}" FontSize="11" Foreground="#6CCB5F" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= VIEW 5: DPI BYPASS & SECURE DOH ================= -->
            <Grid x:Name="ViewDpiBypass" Grid.Row="1" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,12,0">

                        <!-- Master Control Hero Card -->
                        <Border Background="#1CFFFFFF" CornerRadius="8" Padding="18,16" Margin="0,0,0,14" BorderBrush="#24FFFFFF" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Glowing Bypass Badge Icon -->
                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Background="#264CC2FF" BorderBrush="#404CC2FF" BorderThickness="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="GlobeSearch24" FontSize="22" Foreground="#4CC2FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Title, Status & WinINet Checkbox -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource DpiBypass_MasterTitle}" FontWeight="SemiBold" FontSize="14" Foreground="#FFFFFF" Margin="0,0,12,0"/>
                                        <Border x:Name="BadgeDpiStatus" Background="#20888888" BorderBrush="#50888888" BorderThickness="1" CornerRadius="12" Padding="10,3" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtDpiStatus" Text="{DynamicResource DpiBypass_StatusInactive}" FontWeight="SemiBold" FontSize="11" Foreground="#A0A0A0"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource DpiBypass_MasterDesc}" FontSize="11.5" Foreground="#9E9E9E" Margin="0,4,0,8" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,0">
                                        <TextBlock Text="{DynamicResource DpiBypass_PresetLabel}" Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ComboBox x:Name="CmbZapretPreset" Width="260" Height="32" FontSize="12"
                                                  VerticalContentAlignment="Center" Padding="10,0"
                                                  SelectionChanged="CmbZapretPreset_SelectionChanged" Cursor="Hand"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ChkAutoConnectDns" Content="{DynamicResource DpiBypass_ChkAutoConnectDns}" 
                                              IsChecked="True" FontSize="11.5" Foreground="#A0A0A0" Margin="0,8,0,0" Cursor="Hand"/>
                                </StackPanel>

                                <!-- Master Toggle Button -->
                                <ui:Button x:Name="BtnToggleDpiBypass" Grid.Column="2" 
                                           Content="{DynamicResource DpiBypass_BtnEnable}" 
                                           Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Play24}"
                                           Click="BtnToggleDpiBypass_Click" 
                                           VerticalAlignment="Center" Height="40" Padding="18,0" FontSize="12.5"/>
                            </Grid>
                        </Border>

                        <!-- Live Telemetry Metric Cards (3 Columns) -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Metric 1: Active Connections -->
                            <Border Grid.Column="0" Background="#1CFFFFFF" CornerRadius="8" Padding="14,12" BorderBrush="#1AFFFFFF" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" Background="#264CC2FF" BorderBrush="#404CC2FF" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="18" Foreground="#4CC2FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource DpiBypass_MetricActiveSockets}" FontSize="10" FontWeight="SemiBold" Foreground="#A0A0A0" />
                                        <TextBlock x:Name="TxtDpiActiveConn" Text="0" FontSize="15" FontWeight="Bold" Foreground="#4CC2FF" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Metric 2: Bytes Transferred -->
                            <Border Grid.Column="2" Background="#1CFFFFFF" CornerRadius="8" Padding="14,12" BorderBrush="#1AFFFFFF" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" Background="#266CCB5F" BorderBrush="#406CCB5F" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="18" Foreground="#6CCB5F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource DpiBypass_MetricTransferred}" FontSize="10" FontWeight="SemiBold" Foreground="#A0A0A0" />
                                        <TextBlock x:Name="TxtDpiBytes" Text="0 KB" FontSize="15" FontWeight="Bold" Foreground="#6CCB5F" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Metric 3: DoH Cache Hits -->
                            <Border Grid.Column="4" Background="#1CFFFFFF" CornerRadius="8" Padding="14,12" BorderBrush="#1AFFFFFF" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" Background="#26FFC83B" BorderBrush="#40FFC83B" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="18" Foreground="#FFC83B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource DpiBypass_MetricDnsHits}" FontSize="10" FontWeight="SemiBold" Foreground="#A0A0A0" />
                                        <TextBlock x:Name="TxtDpiDnsHits" Text="0" FontSize="15" FontWeight="Bold" Foreground="#FFC83B" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Dynamic DoH Resolvers Monitor Card -->
                        <Border Background="#18FFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,14" BorderBrush="#1AFFFFFF" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource DpiBypass_DohTitle}" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF"/>
                                        <TextBlock Text="{DynamicResource DpiBypass_DohSubtitle}" FontSize="11" Foreground="#9E9E9E" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ui:Button x:Name="BtnRefreshDohPing" Grid.Column="1" Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=ArrowSync24}" 
                                               Click="BtnRefreshDohPing_Click" ToolTip="Ping Resolvers" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- DoH Resolver Rows -->
                                <ItemsControl x:Name="ItemsDohServers">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#12FFFFFF" CornerRadius="6" Padding="12,8" Margin="0,0,0,6" BorderBrush="#15FFFFFF" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#6CCB5F" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDegraded}" Value="True">
                                                                        <Setter Property="Background" Value="#FF99A4" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" Foreground="#FFFFFF" Margin="0,0,10,0"/>
                                                        <TextBlock Text="{Binding DirectIp}" FontSize="11" Foreground="#888888" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <Border Grid.Column="2" Background="#184CC2FF" BorderBrush="#304CC2FF" BorderThickness="1" CornerRadius="8" Padding="8,2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding LatencyMs, StringFormat='{}{0} ms'}" FontSize="11" FontWeight="SemiBold" Foreground="#4CC2FF"/>
                                                    </Border>

                                                    <ui:Button Grid.Column="3" Appearance="Secondary" FontSize="11" Padding="10,0" Height="26"
                                                               Click="BtnConnectDohServer_Click" Tag="{Binding}" Cursor="Hand" VerticalAlignment="Center">
                                                        <ui:Button.Style>
                                                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                                <Setter Property="Content" Value="{DynamicResource DpiBypass_BtnConnectDns}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActiveDns}" Value="True">
                                                                        <Setter Property="Content" Value="{DynamicResource DpiBypass_DnsConnected}" />
                                                                        <Setter Property="Appearance" Value="Success" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:Button.Style>
                                                    </ui:Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Custom Domain Lists Editor Card -->
                        <Border Background="#18FFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,14" BorderBrush="#1AFFFFFF" BorderThickness="1">
                            <StackPanel>
                                <!-- Card Header -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="18" Foreground="#4CC2FF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource DpiBypass_ListsTitle}" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{DynamicResource DpiBypass_ListsDesc}" FontSize="11" Foreground="#9E9E9E" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button x:Name="BtnImportDomainList" Content="{DynamicResource DpiBypass_BtnImportList}" 
                                                   Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=ArrowUpload24}" 
                                                   Click="BtnImportDomainList_Click" Margin="0,0,6,0" FontSize="11" Height="30" Padding="10,0"/>
                                        <ui:Button x:Name="BtnExportDomainList" Content="{DynamicResource DpiBypass_BtnExportList}" 
                                                   Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=ArrowDownload24}" 
                                                   Click="BtnExportDomainList_Click" Margin="0,0,6,0" FontSize="11" Height="30" Padding="10,0"/>
                                        <ui:Button x:Name="BtnFetchCommunityList" Content="{DynamicResource DpiBypass_BtnFetchOnline}" 
                                                   Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=Globe24}" 
                                                   Click="BtnFetchCommunityList_Click" Margin="0,0,8,0" FontSize="11" Height="30" Padding="10,0"/>
                                        <ui:Button x:Name="BtnApplyDomainLists" Content="{DynamicResource DpiBypass_BtnApplyLists}" 
                                                   Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Checkmark24}" 
                                                   Click="BtnApplyDomainLists_Click" FontSize="11.5" Height="30" Padding="14,0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- List Selection Segmented Tabs & Search/Count Row -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Tabs -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button x:Name="BtnTabGeneralList" Content="{DynamicResource DpiBypass_ListGeneral}" 
                                                   Appearance="Primary" Margin="0,0,6,0" Click="BtnTabList_Click" Tag="list-general.txt" Height="28" FontSize="11" Padding="10,0" Cursor="Hand"/>
                                        <ui:Button x:Name="BtnTabGoogleList" Content="{DynamicResource DpiBypass_ListGoogle}" 
                                                   Appearance="Secondary" Margin="0,0,6,0" Click="BtnTabList_Click" Tag="list-google.txt" Height="28" FontSize="11" Padding="10,0" Cursor="Hand"/>
                                        <ui:Button x:Name="BtnTabExcludeList" Content="{DynamicResource DpiBypass_ListExclude}" 
                                                   Appearance="Secondary" Click="BtnTabList_Click" Tag="list-exclude.txt" Height="28" FontSize="11" Padding="10,0" Cursor="Hand"/>
                                    </StackPanel>

                                    <!-- Search Box -->
                                    <ui:TextBox x:Name="TxtSearchDomains" Grid.Column="1" Margin="14,0,12,0" Height="28" 
                                                PlaceholderText="{DynamicResource DpiBypass_SearchDomainsPlaceholder}" 
                                                Icon="{ui:SymbolIcon Symbol=Search24}" HorizontalAlignment="Stretch" MaxWidth="320"
                                                TextChanged="TxtSearchDomains_TextChanged" FontSize="11.5"/>

                                    <!-- Count Badge -->
                                    <Border Grid.Column="2" Background="#184CC2FF" BorderBrush="#304CC2FF" BorderThickness="1" CornerRadius="8" Padding="10,3" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{DynamicResource DpiBypass_DomainsCount}" FontSize="10.5" Foreground="#A0A0A0" Margin="0,0,5,0"/>
                                            <TextBlock x:Name="TxtDomainCountBadge" Text="0" FontSize="11" FontWeight="Bold" Foreground="#4CC2FF"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Fast Add Domain Input Row -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox x:Name="TxtNewDomain" Grid.Column="0" Height="32" Margin="0,0,8,0"
                                                PlaceholderText="{DynamicResource DpiBypass_AddDomainPlaceholder}" 
                                                KeyDown="TxtNewDomain_KeyDown" FontSize="12"/>
                                    <ui:Button x:Name="BtnAddNewDomain" Grid.Column="1" 
                                               Content="{DynamicResource DpiBypass_BtnAddDomain}" 
                                               Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Add24}" 
                                               Click="BtnAddNewDomain_Click" Height="32" Padding="14,0" FontSize="11.5"/>
                                </Grid>

                                <!-- Domain Items List View -->
                                <Border Background="#10FFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="6" Padding="6" Height="220">
                                    <Grid>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl x:Name="ItemsDomainList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#0CFFFFFF" CornerRadius="4" Padding="10,6" Margin="0,0,0,4" BorderBrush="#10FFFFFF" BorderThickness="1">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" Width="6" Height="6" CornerRadius="3" Background="#4CC2FF" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding}" Foreground="#EAEAEA" FontSize="12" FontFamily="Consolas, Segoe UI" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                <ui:Button Grid.Column="2" Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=Dismiss24}" 
                                                                           Padding="4,2" Height="24" Width="26" ToolTip="Удалить / Delete" 
                                                                           Click="BtnDeleteDomain_Click" Tag="{Binding}" Cursor="Hand" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <!-- Empty State Text -->
                                        <TextBlock x:Name="TxtEmptyDomainsState" Text="{DynamicResource DpiBypass_NoDomainsFound}" 
                                                   Foreground="#707070" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                   Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Desynchronization Parameters Card -->
                        <Border Background="#18FFFFFF" CornerRadius="8" Padding="16" BorderBrush="#1AFFFFFF" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource DpiBypass_SettingsTitle}" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF"/>
                                    <TextBlock Text="{DynamicResource DpiBypass_SettingsDesc}" FontSize="11" Foreground="#9E9E9E" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#184CC2FF" BorderBrush="#304CC2FF" BorderThickness="1" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                                    <TextBlock Text="WINDIVERT L3/L4 | DISCORD UDP" FontSize="11" FontWeight="SemiBold" Foreground="#4CC2FF"/>
                                </Border>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Bottom Status Footer -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{DynamicResource Footer_Engine}" 
                           FontSize="11" Foreground="#707070" VerticalAlignment="Center" />

                <ui:Button x:Name="BtnMinimizeToTray" Grid.Column="1" Content="{DynamicResource Action_MinimizeToTray}" 
                           Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=ArrowMinimize24}" Click="BtnMinimizeToTray_Click" />
            </Grid>
        </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
