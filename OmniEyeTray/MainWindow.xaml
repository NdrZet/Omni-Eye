<Window x:Class="OmniEyeTray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OmniEye - Zero-Trust Anti-Exfiltration Console" 
        Height="620" Width="960"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#0E1017"
        Foreground="#E1E4EE">

    <Window.Resources>
        <!-- Modern Scrollbar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Button Base Style -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1E2333"/>
            <Setter Property="Foreground" Value="#E1E4EE"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#293047"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#451821"/>
            <Setter Property="Foreground" Value="#F87171"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#65222E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#1E293B" CornerRadius="10" Width="44" Height="44" Margin="0,0,14,0" BorderBrush="#3B82F6" BorderThickness="1">
                    <TextBlock Text="👁️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="OmniEye" FontWeight="Black" FontSize="20" Foreground="#FFFFFF" />
                        <TextBlock Text=" Zero-Trust" FontWeight="Medium" FontSize="20" Foreground="#60A5FA" Margin="4,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="Аппаратный анти-эксфильтрационный мониторинг и изоляция исходящего трафика" 
                               FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Badges -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="BadgeDevMode" Background="#261E0E" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,10,0">
                    <TextBlock x:Name="TxtDevMode" Text="DEVELOPER MODE" FontWeight="Bold" FontSize="11" Foreground="#FBBF24"/>
                </Border>
                <Border x:Name="BadgeStatus" Background="#0C2518" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="10,4">
                    <TextBlock x:Name="TxtServiceStatus" Text="СЛУЖБА ПОДКЛЮЧЕНА" FontWeight="Bold" FontSize="11" Foreground="#34D399"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Metric Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: Outbound Firewall -->
            <Border Grid.Column="0" Background="#141824" CornerRadius="10" Padding="16" BorderBrush="#1E2438" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="СЕТЕВОЙ ФИЛЬТР (FIREWALL)" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" />
                    <TextBlock x:Name="TxtCardOutbound" Text="БЛОКИРОВАН (BLOCK)" FontSize="15" FontWeight="Bold" Foreground="#F87171" Margin="0,6,0,2" />
                    <TextBlock Text="DNS (53), DHCP (67/68), WinUpdate разрешены" FontSize="11" Foreground="#94A3B8" />
                </StackPanel>
            </Border>

            <!-- Card 2: Whitelist -->
            <Border Grid.Column="2" Background="#141824" CornerRadius="10" Padding="16" BorderBrush="#1E2438" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="БЕЛЫЙ СПИСОК (WHITELIST)" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" />
                    <TextBlock x:Name="TxtCardWhitelistCount" Text="0 приложений" FontSize="15" FontWeight="Bold" Foreground="#60A5FA" Margin="0,6,0,2" />
                    <TextBlock Text="Сквозная валидация Authenticode WinVerifyTrust" FontSize="11" Foreground="#94A3B8" />
                </StackPanel>
            </Border>

            <!-- Card 3: Memory Protection -->
            <Border Grid.Column="4" Background="#141824" CornerRadius="10" Padding="16" BorderBrush="#1E2438" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="ЗАЩИТА ПАМЯТИ (ANTI-INJECTION)" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" />
                    <TextBlock x:Name="TxtCardInjection" Text="АКТИВЕН (ETW + NtSuspend)" FontSize="15" FontWeight="Bold" Foreground="#34D399" Margin="0,6,0,2" />
                    <TextBlock x:Name="TxtCardAttempts" Text="0 подозрительных попыток заблокировано" FontSize="11" Foreground="#94A3B8" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Actions Bar -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="РАЗРЕШЕННЫЕ ПРИЛОЖЕНИЯ В БЕЛОМ СПИСКЕ" 
                       FontWeight="Bold" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center" />

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="BtnAdd" Content="+ Добавить программу (.exe)" 
                        Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="BtnAdd_Click"/>
                <Button x:Name="BtnRemove" Content="Удалить выбранное" 
                        Style="{StaticResource DangerButton}" Margin="0,0,8,0" Click="BtnRemove_Click"/>
                <Button x:Name="BtnRefresh" Content="Обновить" 
                        Style="{StaticResource ActionButton}" Click="BtnRefresh_Click"/>
            </StackPanel>
        </Grid>

        <!-- Whitelist DataGrid -->
        <Border Grid.Row="3" Background="#141824" CornerRadius="8" BorderBrush="#1E2438" BorderThickness="1" Margin="0,0,0,16">
            <DataGrid x:Name="DgWhitelist" AutoGenerateColumns="False" 
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      IsReadOnly="True" SelectionMode="Single"
                      Background="Transparent" RowBackground="#141824" 
                      AlternatingRowBackground="#181D2C"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1E2438"
                      HeadersVisibility="Column" BorderThickness="0"
                      Foreground="#E1E4EE">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#10131E" />
                        <Setter Property="Foreground" Value="#94A3B8" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="Padding" Value="12,10" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="BorderBrush" Value="#1E2438" />
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="{x:Type GroupItem}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type GroupItem}">
                                            <Expander IsExpanded="True" Background="Transparent" BorderThickness="0" Margin="0,2,0,6" Foreground="#94A3B8">
                                                <Expander.Header>
                                                    <Border Background="#161B28" CornerRadius="6" Padding="10,6" Margin="0,2" BorderBrush="#252D42" BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="📁 " FontSize="12"/>
                                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#60A5FA" FontSize="12"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Border Background="#0E121D" CornerRadius="4" Padding="6,2">
                                                                    <TextBlock Text="{Binding ItemCount, StringFormat='{}{0} файлов'}" 
                                                                               FontSize="10" FontWeight="SemiBold" Foreground="#34D399"/>
                                                                </Border>
                                                                <Button Content="Удалить группу" Click="BtnDeleteGroup_Click" 
                                                                        Margin="8,0,0,0" Padding="6,2" FontSize="10" FontWeight="SemiBold"
                                                                        Background="#251419" Foreground="#F87171" BorderBrush="#5E1F2A" BorderThickness="1"
                                                                        Cursor="Hand">
                                                                    <Button.Resources>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="CornerRadius" Value="4"/>
                                                                        </Style>
                                                                    </Button.Resources>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </Expander.Header>
                                                <ItemsPresenter />
                                            </Expander>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </DataGrid.GroupStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ПРОГРАММА" Binding="{Binding FileName}" Width="160" FontWeight="Bold"/>
                    <DataGridTemplateColumn Header="ПОДПИСЬ AUTHENTICODE" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding IsSigned, Converter={x:Null}}" Margin="0,0,4,0"/>
                                    <Border Background="#1C2E24" CornerRadius="4" Padding="6,2" Visibility="{Binding IsSigned, Converter={x:Null}}">
                                        <TextBlock Text="ПОДПИСАН" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="СЕРТИФИКАТ (SUBJECT)" Binding="{Binding SignerSubject}" Width="220" />
                    <DataGridTextColumn Header="ПОЛНЫЙ ПУТЬ" Binding="{Binding FilePath}" Width="*" />
                    <DataGridTextColumn Header="ДОБАВЛЕНО" Binding="{Binding CreatedAt, StringFormat=\{0:dd.MM.yyyy HH:mm\}}" Width="130" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="База данных зашифрована AES-256 (SQLCipher + DPAPI LocalMachine). Эксклюзивная блокировка активна." 
                       FontSize="11" Foreground="#475569" VerticalAlignment="Center" />

            <Button x:Name="BtnMinimizeToTray" Grid.Column="1" Content="Свернуть в трей" 
                    Style="{StaticResource ActionButton}" Click="BtnMinimizeToTray_Click" />
        </Grid>
    </Grid>
</Window>
