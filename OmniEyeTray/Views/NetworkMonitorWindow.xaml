<ui:FluentWindow x:Class="OmniEyeTray.Views.NetworkMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource NetMon_WindowTitle}" 
        Height="800" Width="1300"
        MinHeight="600" MinWidth="950"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        KeyDown="Window_KeyDown">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </ui:FluentWindow.Resources>

    <Grid Background="#101010">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- TitleBar -->
            <RowDefinition Height="Auto"/> <!-- Header & Action Controls Bar -->
            <RowDefinition Height="*"/>    <!-- Main DataGrid -->
            <RowDefinition Height="Auto"/> <!-- Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- Window 11 TitleBar -->
        <ui:TitleBar Grid.Row="0"
                     Title="{DynamicResource NetMon_WindowTitle}" 
                     ShowMaximize="True" ShowMinimize="True"/>

        <!-- Header & Action Controls Bar -->
        <Border Grid.Row="1" Background="#18FFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="0,0,0,1" Padding="20,12,20,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Title, Counters, FullScreen Exit -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#1C4CC2FF" BorderBrush="#404CC2FF" BorderThickness="1" CornerRadius="6" Width="30" Height="30" Margin="0,0,10,0" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="ShieldGlobe24" FontSize="16" Foreground="#4CC2FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{DynamicResource NetMon_Title}" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource NetMon_Subtitle}" FontSize="11" Foreground="#8E8E8E" Margin="40,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Socket Count Badge -->
                        <Border Background="#1A4CC2FF" BorderBrush="#404CC2FF" BorderThickness="1" CornerRadius="12" Padding="12,5" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtConnectionsCount" Text="Active sockets: 0" FontWeight="SemiBold" FontSize="11" Foreground="#4CC2FF"/>
                        </Border>

                        <!-- Refresh Button -->
                        <ui:Button x:Name="BtnRefreshConnections" Content="{DynamicResource NetMon_BtnRefresh}"
                                   Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=ArrowSync24}"
                                   Click="BtnRefreshConnections_Click" VerticalAlignment="Center" Height="32" Margin="0,0,8,0"/>

                        <!-- Exit Fullscreen Button -->
                        <ui:Button x:Name="BtnExitFullScreen" Content="{DynamicResource NetMon_BtnExitFullScreen}"
                                   Appearance="Primary" Icon="{ui:SymbolIcon Symbol=FullScreenMinimize24}"
                                   Click="BtnExitFullScreen_Click" VerticalAlignment="Center" Height="32"/>
                    </StackPanel>
                </Grid>

                <!-- Row 1: Search and Filters -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Box -->
                    <ui:TextBox x:Name="TxtConnectionSearch" 
                                PlaceholderText="{DynamicResource NetMon_SearchPlaceholder}"
                                TextChanged="TxtConnectionSearch_TextChanged"
                                Icon="{ui:SymbolIcon Symbol=Search24}"
                                Height="34" Margin="0,0,10,0" VerticalAlignment="Center"/>

                    <!-- Protocol Filter -->
                    <ComboBox x:Name="CmbProtocolFilter" Grid.Column="1" Width="150" Height="34" 
                              SelectionChanged="CmbProtocolFilter_SelectionChanged" VerticalAlignment="Center" Margin="0,0,10,0">
                        <ComboBoxItem Content="{DynamicResource NetMon_FilterAll}" IsSelected="True" Tag="ALL"/>
                        <ComboBoxItem Content="{DynamicResource NetMon_FilterTcp}" Tag="TCP"/>
                        <ComboBoxItem Content="{DynamicResource NetMon_FilterUdp}" Tag="UDP"/>
                    </ComboBox>

                    <!-- Status Filter -->
                    <ComboBox x:Name="CmbStatusFilter" Grid.Column="2" Width="180" Height="34" 
                              SelectionChanged="CmbStatusFilter_SelectionChanged" VerticalAlignment="Center">
                        <ComboBoxItem Content="{DynamicResource NetMon_FilterStatusAll}" IsSelected="True" Tag="ALL"/>
                        <ComboBoxItem Content="{DynamicResource NetMon_StatusWhitelisted}" Tag="WHITELISTED"/>
                        <ComboBoxItem Content="{DynamicResource NetMon_StatusBlocked}" Tag="BLOCKED"/>
                        <ComboBoxItem Content="{DynamicResource NetMon_StatusException}" Tag="EXCEPTION"/>
                        <ComboBoxItem Content="{DynamicResource NetMon_StatusPermissive}" Tag="PERMISSIVE"/>
                    </ComboBox>
                </Grid>
            </Grid>
        </Border>

        <!-- Main FullScreen DataGrid -->
        <Border Grid.Row="2" Padding="20,12,20,12">
            <DataGrid x:Name="DgConnections" AutoGenerateColumns="False" 
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                      Background="Transparent" RowBackground="#14FFFFFF" 
                      AlternatingRowBackground="#0AFFFFFF"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#14FFFFFF"
                      HeadersVisibility="Column" BorderThickness="1" BorderBrush="#1CFFFFFF"
                      Foreground="#FFFFFF" SelectionMode="Single"
                      ScrollViewer.CanContentScroll="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1C1C1C"/>
                        <Setter Property="Foreground" Value="#A0A0A0"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#25FFFFFF"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="8,5"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <!-- Process -->
                    <DataGridTemplateColumn Header="{DynamicResource NetMon_ColProcess}" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding ProcessPath}">
                                    <ui:SymbolIcon Symbol="AppGeneric24" FontSize="15" Foreground="#4CC2FF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                        <TextBlock Text="{Binding ProcessId, StringFormat='PID: {0}'}" FontSize="10" Foreground="#8E8E8E"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Protocol Badge -->
                    <DataGridTemplateColumn Header="{DynamicResource NetMon_ColProtocol}" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding ProtocolBadgeBackground}" BorderBrush="{Binding ProtocolBadgeBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ProtocolName}" FontSize="10" FontWeight="Bold" Foreground="{Binding ProtocolBadgeForeground}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Local Endpoint -->
                    <DataGridTemplateColumn Header="{DynamicResource NetMon_ColLocal}" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LocalEndpoint}" FontFamily="Consolas, Segoe UI" FontSize="11" Foreground="#D0D0D0" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Remote Endpoint -->
                    <DataGridTemplateColumn Header="{DynamicResource NetMon_ColRemote}" Width="210">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RemoteEndpoint}" FontFamily="Consolas, Segoe UI" FontSize="11" Foreground="#CCCCCC" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- State -->
                    <DataGridTemplateColumn Header="{DynamicResource NetMon_ColState}" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding State}" FontSize="11" Foreground="#A8A8A8" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Policy Status Badge -->
                    <DataGridTemplateColumn Header="{DynamicResource NetMon_ColStatus}" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding StatusBadgeBackground}" BorderBrush="{Binding StatusBadgeBorder}" BorderThickness="1" CornerRadius="8" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding StatusBadgeForeground}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Executable Path (Visible in Full Screen) -->
                    <DataGridTemplateColumn Header="{DynamicResource NetMon_ColPath}" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ProcessPath}" FontFamily="Consolas, Segoe UI" FontSize="10" Foreground="#888888" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProcessPath}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Quick Whitelist Action -->
                    <DataGridTemplateColumn Header="{DynamicResource NetMon_ColAction}" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ui:Button Content="{DynamicResource NetMon_ActionAdd}" 
                                           FontSize="10" Padding="8,2" Height="26"
                                           Appearance="Secondary"
                                           Visibility="{Binding CanAddToWhitelist, Converter={StaticResource BoolToVisConverter}}"
                                           Click="BtnAddConnectionToWhitelist_Click"
                                           Tag="{Binding ProcessPath}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="3" Background="#141414" BorderBrush="#1CFFFFFF" BorderThickness="0,1,0,0" Padding="20,8,20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Pills -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- TCP Pill -->
                    <Border Background="#1A4CC2FF" BorderBrush="#304CC2FF" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,8,0">
                        <TextBlock x:Name="TxtStatTcp" Text="TCP: 0" FontSize="11" Foreground="#4CC2FF"/>
                    </Border>
                    <!-- UDP Pill -->
                    <Border Background="#1AB47CFF" BorderBrush="#30B47CFF" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,8,0">
                        <TextBlock x:Name="TxtStatUdp" Text="UDP: 0" FontSize="11" Foreground="#D1A8FF"/>
                    </Border>
                    <!-- Whitelisted Pill -->
                    <Border Background="#1A4CE8A3" BorderBrush="#304CE8A3" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,8,0">
                        <TextBlock x:Name="TxtStatWhitelisted" Text="Whitelisted: 0" FontSize="11" Foreground="#4CE8A3"/>
                    </Border>
                    <!-- Blocked Pill -->
                    <Border Background="#1AFF99A4" BorderBrush="#30FF99A4" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,8,0">
                        <TextBlock x:Name="TxtStatBlocked" Text="Blocked: 0" FontSize="11" Foreground="#FF99A4"/>
                    </Border>
                    <!-- Exceptions Pill -->
                    <Border Background="#1AFFC83B" BorderBrush="#30FFC83B" BorderThickness="1" CornerRadius="6" Padding="8,3">
                        <TextBlock x:Name="TxtStatExceptions" Text="Exceptions: 0" FontSize="11" Foreground="#FFC83B"/>
                    </Border>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="ESC to close | Auto-refresh: 3s" FontSize="11" Foreground="#666666" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
