<Window x:Class="OmniEyeTray.Views.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource Alert_WindowTitle}" 
        Height="430" Width="580"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable, Segoe UI, -apple-system, sans-serif">

    <Border Background="#202020" 
            BorderBrush="#C42B1C" 
            BorderThickness="1.5" 
            CornerRadius="8" 
            Padding="24">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="4" Opacity="0.65" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <Border Background="#3B171A" BorderBrush="#6B2329" BorderThickness="1" CornerRadius="8" Width="42" Height="42" Margin="0,0,12,0">
                    <ui:SymbolIcon Symbol="ShieldError24" FontSize="22" Foreground="#FF99A4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Alert_Header}" 
                               FontWeight="Bold" FontSize="14" Foreground="#FF99A4" />
                    <TextBlock Text="{DynamicResource Alert_Subtitle}" 
                               FontSize="11" Foreground="#A0A0A0" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- Details Card -->
            <Border Grid.Row="1" Background="#2B2B2B" CornerRadius="8" Padding="14" BorderBrush="#383838" BorderThickness="1" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Alert_SourceLabel}" FontSize="10" FontWeight="SemiBold" Foreground="#A0A0A0" />
                    <TextBlock x:Name="TxtSourcePath" Text="C:\Unknown\MaliciousProcess.exe" 
                               FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <Border Background="#3B171A" BorderBrush="#6B2329" BorderThickness="1" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" Margin="0,4,0,12">
                        <TextBlock x:Name="TxtSourcePid" Text="PID: 1234" FontSize="11" FontWeight="SemiBold" Foreground="#FF99A4" />
                    </Border>

                    <TextBlock Text="{DynamicResource Alert_TargetLabel}" FontSize="10" FontWeight="SemiBold" Foreground="#A0A0A0" />
                    <TextBlock x:Name="TxtTargetPath" Text="C:\Program Files\App\ProtectedApp.exe" 
                               FontSize="13" FontWeight="SemiBold" Foreground="#6CCB5F" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <Border Background="#133821" BorderBrush="#1E6135" BorderThickness="1" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" Margin="0,4,0,0">
                        <TextBlock x:Name="TxtTargetPid" Text="PID: 5678" FontSize="11" FontWeight="SemiBold" Foreground="#6CCB5F" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Countdown Timer Bar -->
            <StackPanel Grid.Row="2" Margin="0,0,0,18">
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="{DynamicResource Alert_TimerLabel}" FontSize="11" Foreground="#A0A0A0" HorizontalAlignment="Left" />
                    <TextBlock x:Name="TxtTimer" Text="60" FontSize="11" FontWeight="Bold" Foreground="#FF99A4" HorizontalAlignment="Right" />
                </Grid>
                <ProgressBar x:Name="PbCountdown" Height="4" Value="60" Maximum="60" 
                             Foreground="#C42B1C" Background="#2B2B2B" BorderThickness="0" />
            </StackPanel>

            <!-- Actions (Windows 11 Fluent Buttons) -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ui:Button x:Name="BtnKill" Grid.Column="0" Content="{DynamicResource Alert_Kill}" 
                           Appearance="Danger" Icon="{ui:SymbolIcon Symbol=Dismiss24}"
                           Height="38" HorizontalAlignment="Stretch"
                           FontWeight="SemiBold" FontSize="12"
                           Click="BtnKill_Click" />

                <ui:Button x:Name="BtnIgnore" Grid.Column="2" Content="{DynamicResource Alert_Ignore}" 
                           Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=Checkmark24}"
                           Height="38" HorizontalAlignment="Stretch"
                           FontWeight="SemiBold" FontSize="12"
                           Click="BtnIgnore_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
