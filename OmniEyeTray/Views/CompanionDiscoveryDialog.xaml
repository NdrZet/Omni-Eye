<Window x:Class="OmniEyeTray.Views.CompanionDiscoveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OmniEye - Обнаружение компонентов приложения" 
        Height="540" Width="820"
        MinHeight="460" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="#0E1017"
        Foreground="#E1E4EE">

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1E2333"/>
            <Setter Property="Foreground" Value="#E1E4EE"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#293047"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#1E293B" CornerRadius="8" Width="40" Height="40" Margin="0,0,12,0" BorderBrush="#3B82F6" BorderThickness="1">
                    <TextBlock Text="🧩" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ОБНАРУЖЕНЫ СОПУТСТВУЮЩИЕ КОМПОНЕНТЫ" FontWeight="Bold" FontSize="16" Foreground="#FFFFFF" />
                    <TextBlock x:Name="TxtSubtitle" Text="Программа использует несколько модулей (фоновые службы, туннели, апдейтеры)." 
                               FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Quick selection bar -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TxtSummary" Text="Выберите исполняемые файлы, которым разрешен выход в сеть:" 
                       FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Выбрать все" Style="{StaticResource ActionButton}" Padding="10,4" Margin="0,0,6,0" Click="BtnSelectAll_Click"/>
                <Button Content="Снять выделение" Style="{StaticResource ActionButton}" Padding="10,4" Click="BtnUnselectAll_Click"/>
            </StackPanel>
        </Grid>

        <!-- Components DataGrid -->
        <Border Grid.Row="2" Background="#141824" CornerRadius="8" BorderBrush="#1E2438" BorderThickness="1" Margin="0,0,0,16">
            <DataGrid x:Name="DgComponents" AutoGenerateColumns="False" 
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      Background="Transparent" RowBackground="#141824" 
                      AlternatingRowBackground="#181D2C"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1E2438"
                      HeadersVisibility="Column" BorderThickness="0"
                      Foreground="#E1E4EE">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#10131E" />
                        <Setter Property="Foreground" Value="#94A3B8" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="BorderBrush" Value="#1E2438" />
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <!-- Checkbox Column -->
                    <DataGridTemplateColumn Width="46">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- File Name -->
                    <DataGridTextColumn Header="ФАЙЛ" Binding="{Binding FileName}" Width="170" FontWeight="Bold"/>

                    <!-- Role Badge -->
                    <DataGridTemplateColumn Header="НАЗНАЧЕНИЕ" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#1E293B" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Role}" FontSize="10" FontWeight="SemiBold" Foreground="#60A5FA"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Signature -->
                    <DataGridTemplateColumn Header="ПОДПИСЬ" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#1C2E24" CornerRadius="4" Padding="6,2" Visibility="{Binding IsSigned, Converter={x:Null}}">
                                        <TextBlock Text="ПОДПИСАН" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Full Path -->
                    <DataGridTextColumn Header="ПУТЬ К ФАЙЛУ" Binding="{Binding FilePath}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer Actions -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TxtSelectionCount" Text="Выбрано: 0 файлов" 
                       FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnCancel" Content="Отмена" 
                        Style="{StaticResource ActionButton}" Margin="0,0,10,0" Click="BtnCancel_Click"/>
                <Button x:Name="BtnConfirm" Content="Добавить выбранные в Белый список" 
                        Style="{StaticResource PrimaryButton}" Click="BtnConfirm_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
